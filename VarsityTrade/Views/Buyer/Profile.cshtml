@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<div class="vt-body">
    @await Html.PartialAsync("_Sidebar")

    <div>
        <div class="vt-card">
            <div class="vt-card-title">
                <i class="ti ti-user" aria-hidden="true"></i> My Profile
            </div>

            <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;">
                <div style="width:64px;height:64px;border-radius:50%;background:var(--vt-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:500;">
                    @(Context.Session.GetString("UserInitials") ?? "?")
                </div>
                <div>
                    <div style="font-size:17px;font-weight:500;">
                        @Context.Session.GetString("FirstName") @Context.Session.GetString("LastName")
                    </div>
                    <div style="font-size:12px;color:var(--vt-text-muted);">
                        @Context.Session.GetString("UserEmail")
                    </div>
                    <span class="vt-badge vt-badge-primary" style="margin-top:4px;">
                        @Context.Session.GetString("UserRole")
                    </span>
                </div>
            </div>

            <div class="vt-divider"></div>

            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;">
                <a href="/seller/activate" class="vt-btn vt-btn-primary">
                    <i class="ti ti-store" aria-hidden="true"></i> Activate Seller Profile
                </a>
                <a href="/auth/logout" class="vt-btn vt-btn-outline">
                    <i class="ti ti-logout" aria-hidden="true"></i> Log out
                </a>
            </div>
        </div>
    </div>
</div>