@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
    var hasSellerProfile = Context.Session.GetString("HasSellerProfile") == "true";
    var currentMode = Context.Session.GetString("CurrentMode") ?? "Buyer";
    var isSeller = currentMode == "Seller";
}

<div class="vt-body">
    @await Html.PartialAsync("_Sidebar")

    <div>
        @* Profile banner *@
        <div class="vt-card" style="background:linear-gradient(135deg,#4B3BC7,#26215C);margin-bottom:14px;">
            <div style="display:flex;align-items:center;gap:16px;">
                <div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,0.2);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:500;border:2px solid rgba(255,255,255,0.4);">
                    @(Context.Session.GetString("UserInitials") ?? "?")
                </div>
                <div>
                    <div style="font-size:18px;font-weight:500;color:#fff;">
                        @Context.Session.GetString("FirstName") @Context.Session.GetString("LastName")
                    </div>
                    <div style="font-size:12px;color:#AFA9EC;margin-top:2px;">
                        @Context.Session.GetString("UserEmail")
                    </div>
                    <div style="display:flex;gap:6px;margin-top:6px;">
                        <span class="vt-badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                            @Context.Session.GetString("UserRole")
                        </span>
                        @if (hasSellerProfile)
                        {
                            <span class="vt-badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                                <i class="ti ti-store" aria-hidden="true"></i> Seller
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Mode switch card — only shown if user has seller profile *@
        @if (hasSellerProfile)
        {
            <div class="vt-card" style="margin-bottom:14px;">
                <div class="vt-card-title">
                    <i class="ti ti-switch-horizontal" aria-hidden="true"></i> Switch mode
                </div>
                <p style="font-size:12px;color:var(--vt-text-muted);margin-bottom:12px;">
                    You have both a buyer and seller account. Switch between modes to access different features.
                </p>
                <div style="display:flex;gap:10px;">
                    @if (isSeller)
                    {
                        <a href="/seller/switch-to-buyer" class="vt-btn vt-btn-primary">
                            <i class="ti ti-shopping-cart" aria-hidden="true"></i> Switch to Buyer mode
                        </a>
                        <span class="vt-badge vt-badge-success" style="align-self:center;">
                            Currently in Seller mode
                        </span>
                    }
                    else
                    {
                        <a href="/seller/switch-to-seller" class="vt-btn vt-btn-primary">
                            <i class="ti ti-store" aria-hidden="true"></i> Switch to Seller mode
                        </a>
                        <span class="vt-badge vt-badge-primary" style="align-self:center;">
                            Currently in Buyer mode
                        </span>
                    }
                </div>
            </div>
        }

        @* Account actions *@
        <div class="vt-card">
            <div class="vt-card-title">
                <i class="ti ti-settings" aria-hidden="true"></i> Account
            </div>

            @* Only show activate seller if they do NOT have one yet *@
            @if (!hasSellerProfile)
            {
                <div style="background:var(--vt-primary-light);border-radius:var(--vt-radius-md);padding:14px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <div style="font-size:13px;font-weight:500;color:var(--vt-primary);">Start selling on Varsity Trade</div>
                        <div style="font-size:11px;color:var(--vt-primary-mid);margin-top:2px;">Set up your seller profile and reach students at your campus.</div>
                    </div>
                    <a href="/seller/activate" class="vt-btn vt-btn-primary" style="white-space:nowrap;">
                        <i class="ti ti-store" aria-hidden="true"></i> Activate seller
                    </a>
                </div>
            }

            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <a href="/auth/logout" class="vt-btn vt-btn-outline">
                    <i class="ti ti-logout" aria-hidden="true"></i> Log out
                </a>
            </div>
        </div>
    </div>
</div>