@{
    ViewData["Title"] = "Saved Listings";
    ViewData["SidebarPage"] = "saved";
    Layout = "_Layout";
    var listings = ViewBag.SavedListings as List<VarsityTrade.Web.Models.Listings.ListingCardViewModel> ?? new();
    var activeFilter = ViewBag.ActiveFilter as string ?? "All";
}

<div style="display:grid;grid-template-columns:220px 1fr;gap:14px;padding:16px 24px;align-items:start;">
    @await Html.PartialAsync("_SidebarFull")

    <div>
        @* Page header *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div>
                <div style="font-size:15px;font-weight:500;color:#26215C;margin-bottom:2px;">
                    <i class="ti ti-heart" aria-hidden="true" style="color:#4B3BC7;"></i> Saved listings
                </div>
                <div style="font-size:11px;color:#888;">Items you have saved for later — @listings.Count item@(listings.Count != 1 ? "s" : "")</div>
            </div>
        </div>

        @* Toolbar *@
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <div style="font-size:12px;color:#666;">
                Showing <b style="color:#26215C;">@listings.Count</b> saved item@(listings.Count != 1 ? "s" : "")
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <select style="border:0.5px solid #ddd;border-radius:6px;padding:5px 8px;font-size:12px;color:#444;background:#fff;">
                    <option>Sort: Recently saved</option>
                    <option>Price: Low to high</option>
                    <option>Price: High to low</option>
                </select>
                <div style="display:flex;gap:4px;">
                    <div style="width:28px;height:28px;border:0.5px solid #AFA9EC;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#4B3BC7;font-size:14px;background:#EEEDFE;">
                        <i class="ti ti-layout-grid" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
        </div>

        @* Filter tabs *@
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            @foreach (var f in new[] { "All", "Price dropped", "Still available" })
            {
                <a href="/buyer/saved?filter=@f"
                   style="font-size:11px;border:0.5px solid @(activeFilter == f ? "#AFA9EC" : "#ddd");border-radius:6px;padding:5px 10px;text-decoration:none;@(activeFilter == f ? "background:#EEEDFE;color:#4B3BC7;font-weight:500;" : "color:#666;background:#fff;")">
                    @f
                </a>
            }
        </div>

        @* Grid *@
        @if (listings.Any())
        {
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;">
                @foreach (var listing in listings)
                {
                    var daysAgo = (int)(DateTime.UtcNow - listing.CreatedAt).TotalDays;
                    <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;overflow:hidden;">
                        <div style="background:#f0eefb;height:86px;display:flex;align-items:center;justify-content:center;color:#7F77DD;position:relative;font-size:28px;">
                            @if (!string.IsNullOrEmpty(listing.CoverImageUrl))
                            {
                                <img src="@listing.CoverImageUrl" alt="@listing.Title" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <i class="ti ti-photo" aria-hidden="true"></i>
                            }
                            <div style="position:absolute;top:6px;right:6px;color:#e74c3c;font-size:15px;">
                                <i class="ti ti-heart-filled" aria-hidden="true"></i>
                            </div>
                            @if (listing.IsFeatured)
                            {
                                <div style="position:absolute;top:6px;left:6px;background:#4B3BC7;color:#fff;font-size:9px;padding:2px 6px;border-radius:4px;">Featured</div>
                            }
                        </div>
                        <div style="padding:8px 10px;">
                            <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@listing.Title</div>
                            <div style="font-size:12px;font-weight:500;color:#4B3BC7;margin-bottom:3px;">R @listing.Price.ToString("N0")</div>
                            <div style="font-size:10px;color:#888;margin-bottom:6px;">@listing.Condition · @daysAgo@(daysAgo == 0 ? "Today" : $"{daysAgo}d ago")</div>
                            <div style="display:flex;gap:5px;">
                                <a href="/listings/@listing.ListingId" style="flex:1;background:#4B3BC7;color:#fff;border:none;border-radius:5px;padding:5px;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:3px;text-decoration:none;">
                                    <i class="ti ti-eye" aria-hidden="true"></i> View
                                </a>
                                <button style="flex:1;background:#fff;color:#666;border:0.5px solid #ddd;border-radius:5px;padding:5px;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:3px;">
                                    <i class="ti ti-message-circle" aria-hidden="true"></i> Message
                                </button>
                                <button style="background:#FDECEA;color:#B91C1C;border:none;border-radius:5px;padding:5px 7px;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;">
                                    <i class="ti ti-heart-off" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;text-align:center;padding:60px 20px;">
                <i class="ti ti-heart" aria-hidden="true" style="font-size:40px;color:#AFA9EC;display:block;margin-bottom:12px;"></i>
                <div style="font-size:14px;font-weight:500;margin-bottom:6px;">No saved listings yet</div>
                <p style="font-size:12px;color:#888;">Browse listings and tap the heart icon to save items for later.</p>
                <a href="/listings/browse" style="display:inline-flex;align-items:center;gap:6px;background:#4B3BC7;color:#fff;border-radius:7px;padding:9px 18px;font-size:12px;font-weight:500;text-decoration:none;margin-top:14px;">
                    <i class="ti ti-search" aria-hidden="true"></i> Browse listings
                </a>
            </div>
        }
    </div>
</div>