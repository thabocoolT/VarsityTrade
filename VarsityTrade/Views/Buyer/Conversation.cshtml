@model VarsityTrade.Web.Models.Buyer.ConversationThreadViewModel
@{
    ViewData["Title"] = "Conversation";
    ViewData["SidebarPage"] = "inbox";
    Layout = "_Layout";
    var currentUserId = Model.CurrentUserId;
    var storeName     = Model.Conversation.StoreName;
    var storeInitial  = storeName.Length > 0 ? storeName[0].ToString().ToUpper() : "?";
}

<div style="display:grid;grid-template-columns:44px 1fr;gap:12px;padding:16px 24px;align-items:start;">
    @await Html.PartialAsync("_Sidebar")

    <div style="display:grid;grid-template-columns:1fr 260px;gap:12px;align-items:start;">

        @* Thread panel *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;">

            @* Thread header *@
            <div style="padding:12px 16px;border-bottom:0.5px solid #e0ddf5;display:flex;align-items:center;gap:10px;">
                <a href="/buyer/inbox" style="color:#4B3BC7;font-size:13px;display:flex;align-items:center;gap:4px;text-decoration:none;margin-right:4px;">
                    <i class="ti ti-arrow-left" aria-hidden="true"></i> Back
                </a>
                <div style="width:36px;height:36px;border-radius:50%;background:#4B3BC7;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;flex-shrink:0;">
                    @storeInitial
                </div>
                <div>
                    <div style="font-size:13px;font-weight:500;color:#26215C;">@storeName</div>
                    <div style="font-size:11px;color:#888;">
                        <i class="ti ti-building" aria-hidden="true" style="font-size:10px;"></i>
                        NWU Vaal Campus · Online
                    </div>
                </div>
                <div style="margin-left:auto;display:flex;gap:8px;">
                    <a href="/buyer/offers/make?listingId=@Model.Conversation.ListingId"
                       style="border:0.5px solid #ddd;border-radius:6px;padding:5px 10px;font-size:11px;color:#555;background:#fff;display:flex;align-items:center;gap:4px;text-decoration:none;">
                        <i class="ti ti-arrows-exchange" aria-hidden="true"></i> Make offer
                    </a>
                    <div style="border:0.5px solid #ddd;border-radius:6px;padding:5px 10px;font-size:11px;color:#555;background:#fff;display:flex;align-items:center;gap:4px;cursor:pointer;">
                        <i class="ti ti-flag" aria-hidden="true"></i> Report
                    </div>
                </div>
            </div>

            @* Listing bar *@
            <div style="background:#f5f4f9;border-bottom:0.5px solid #e0ddf5;padding:8px 16px;display:flex;align-items:center;gap:10px;">
                <div style="width:36px;height:36px;background:#EEEDFE;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#4B3BC7;font-size:16px;flex-shrink:0;">
                    <i class="ti ti-tag" aria-hidden="true"></i>
                </div>
                <div>
                    <div style="font-size:12px;font-weight:500;color:#26215C;">@Model.Conversation.ListingTitle</div>
                    <div style="font-size:11px;color:#4B3BC7;">R @Model.Conversation.ListingPrice.ToString("N0")</div>
                </div>
                <a href="/listings/@Model.Conversation.ListingId" style="font-size:11px;color:#4B3BC7;margin-left:auto;white-space:nowrap;text-decoration:none;">View listing →</a>
            </div>

            @* Messages *@
            <div style="padding:16px;display:flex;flex-direction:column;gap:12px;min-height:280px;background:#fff;">
                @if (Model.Messages.Any())
                {
                    DateTime? lastDate = null;
                    @foreach (var msg in Model.Messages)
                    {
                        var isMe    = msg.SenderId == currentUserId;
                        var msgDate = msg.SentAt.Date;

                        if (lastDate == null || lastDate != msgDate)
                        {
                            var dateLabel = msgDate == DateTime.UtcNow.Date ? "Today"
                                          : msgDate == DateTime.UtcNow.Date.AddDays(-1) ? "Yesterday"
                                          : msgDate.ToString("dd MMM yyyy");
                            <div style="text-align:center;font-size:10px;color:#aaa;margin:4px 0;">@dateLabel</div>
                            lastDate = msgDate;
                        }

                        var senderInitial = $"{msg.SenderFirstName[0]}".ToUpper();
                        <div style="display:flex;gap:8px;align-items:flex-end;@(isMe?"flex-direction:row-reverse;":"")">
                            <div style="width:28px;height:28px;border-radius:50%;@(isMe?"background:#4B3BC7;color:#fff;":"background:#ddd;color:#888;")display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;flex-shrink:0;">
                                @senderInitial
                            </div>
                            <div style="display:flex;flex-direction:column;gap:3px;max-width:72%;">
                                <div style="padding:9px 12px;border-radius:@(isMe?"12px 12px 2px 12px":"12px 12px 12px 2px");font-size:12px;line-height:1.5;@(isMe?"background:#4B3BC7;color:#fff;":"background:#f5f4f9;color:#26215C;")">
                                    @msg.Content
                                </div>
                                <div style="font-size:10px;color:#aaa;@(isMe?"text-align:right;":"")">
                                    @msg.SentAt.ToString("HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align:center;font-size:12px;color:#888;padding:20px;">No messages yet. Start the conversation!</div>
                }
            </div>

            @* Reply bar *@
            <div style="border-top:0.5px solid #e0ddf5;padding:10px 16px;display:flex;align-items:center;gap:8px;background:#fff;">
                <i class="ti ti-paperclip" aria-hidden="true" style="color:#aaa;font-size:18px;cursor:pointer;"></i>
                <form asp-controller="Buyer" asp-action="SendMessage" method="post" style="flex:1;display:flex;gap:8px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@Model.Conversation.ConversationId" />
                    <input type="text" name="content" placeholder="Type a message..."
                           style="flex:1;border:0.5px solid #ddd;border-radius:20px;padding:8px 14px;font-size:12px;background:#f5f4f9;color:#26215C;outline:none;" required />
                    <button type="submit" style="background:#4B3BC7;color:#fff;border:none;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:14px;cursor:pointer;flex-shrink:0;">
                        <i class="ti ti-send" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </div>

        @* Right panel *@
        <div style="display:flex;flex-direction:column;gap:12px;">

            @* Seller details card *@
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;">
                    <i class="ti ti-user" aria-hidden="true"></i> Seller details
                </div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:#4B3BC7;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;">
                        @storeInitial
                    </div>
                    <div>
                        <div style="font-size:12px;font-weight:500;color:#26215C;">@storeName</div>
                        <div style="font-size:10px;color:#888;"><i class="ti ti-building" aria-hidden="true" style="font-size:10px;"></i> NWU Vaal Campus</div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px;">
                    <div style="background:#f5f4f9;border-radius:6px;padding:5px;text-align:center;">
                        <div style="font-size:12px;font-weight:500;color:#26215C;"><span style="color:#BA7517;">★</span>@Model.Conversation.SellerRating.ToString("F1")</div>
                        <div style="font-size:9px;color:#888;">Rating</div>
                    </div>
                    <div style="background:#f5f4f9;border-radius:6px;padding:5px;text-align:center;">
                        <div style="font-size:12px;font-weight:500;color:#26215C;">—</div>
                        <div style="font-size:9px;color:#888;">Sales</div>
                    </div>
                    <div style="background:#f5f4f9;border-radius:6px;padding:5px;text-align:center;">
                        <div style="font-size:12px;font-weight:500;color:#26215C;">~1h</div>
                        <div style="font-size:9px;color:#888;">Response</div>
                    </div>
                </div>
                <a href="/seller/@Model.Conversation.SellerProfileId"
                   style="width:100%;border:1.5px solid #4B3BC7;border-radius:7px;padding:8px;font-size:11px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;text-decoration:none;color:#4B3BC7;background:#fff;">
                    <i class="ti ti-user" aria-hidden="true"></i> View profile
                </a>
            </div>

            @* Listing card *@
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;">
                    <i class="ti ti-tag" aria-hidden="true"></i> Listing
                </div>
                <div style="background:#f5f4f9;border-radius:8px;overflow:hidden;margin-bottom:8px;">
                    <div style="background:#EEEDFE;height:60px;display:flex;align-items:center;justify-content:center;color:#4B3BC7;font-size:24px;">
                        <i class="ti ti-photo" aria-hidden="true"></i>
                    </div>
                    <div style="padding:7px 9px;">
                        <div style="font-size:11px;font-weight:500;color:#26215C;margin-bottom:2px;">@Model.Conversation.ListingTitle</div>
                        <div style="font-size:12px;font-weight:500;color:#4B3BC7;">R @Model.Conversation.ListingPrice.ToString("N0")</div>
                    </div>
                </div>
                <a href="/buyer/offers/make?listingId=@Model.Conversation.ListingId"
                   style="width:100%;background:#4B3BC7;color:#fff;border:none;border-radius:7px;padding:8px;font-size:11px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;text-decoration:none;margin-bottom:5px;">
                    <i class="ti ti-arrows-exchange" aria-hidden="true"></i> Make trade offer
                </a>
                <a href="/listings/@Model.Conversation.ListingId"
                   style="width:100%;background:#fff;color:#888;border:0.5px solid #ddd;border-radius:7px;padding:8px;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;text-decoration:none;">
                    <i class="ti ti-eye" aria-hidden="true"></i> View full listing
                </a>
            </div>

            @* Safety tips *@
            <div style="background:#EEEDFE;border:0.5px solid #AFA9EC;border-radius:12px;padding:12px;">
                <div style="font-size:11px;font-weight:500;color:#3C3489;margin-bottom:6px;display:flex;align-items:center;gap:4px;">
                    <i class="ti ti-shield-check" aria-hidden="true"></i> Safety tips
                </div>
                @foreach (var tip in new[] {
                    "Meet on campus in a public area",
                    "Inspect the item before paying",
                    "Never pay upfront or transfer money",
                    "Report anything suspicious",
                })
                {
                    <div style="font-size:10px;color:#534AB7;display:flex;align-items:flex-start;gap:4px;margin-bottom:4px;line-height:1.4;">
                        <i class="ti ti-check" aria-hidden="true" style="margin-top:1px;min-width:11px;"></i> @tip
                    </div>
                }
            </div>
        </div>
    </div>
</div>