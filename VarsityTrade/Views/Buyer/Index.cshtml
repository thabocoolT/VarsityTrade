@model VarsityTrade.Web.Models.Buyer.BuyerDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    ViewData["SidebarPage"] = "buyer-dashboard";
    Layout = "_Layout";
    var firstName = Context.Session.GetString("FirstName") ?? "there";
}

<div class="vt-body">
    @await Html.PartialAsync("_SidebarFull")

    <div class="vt-main">

        @* Welcome bar *@
        <div style="background:linear-gradient(135deg,#4B3BC7,#26215C);border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div>
                <div style="font-size:14px;font-weight:500;color:#fff;margin-bottom:2px;">Good day, @firstName 👋</div>
                <div style="font-size:11px;color:#AFA9EC;">You are browsing listings at NWU Vaal Campus</div>
            </div>
            <div style="display:flex;gap:8px;">
                <a href="/listings/browse" style="background:rgba(255,255,255,0.15);color:#fff;border:none;border-radius:6px;padding:7px 12px;font-size:11px;display:flex;align-items:center;gap:5px;text-decoration:none;">
                    <i class="ti ti-search" aria-hidden="true"></i> Browse
                </a>
                <a href="/seller/activate" style="background:#fff;color:#4B3BC7;border:none;border-radius:6px;padding:7px 12px;font-size:11px;font-weight:500;display:flex;align-items:center;gap:5px;text-decoration:none;">
                    <i class="ti ti-plus" aria-hidden="true"></i> Sell an item
                </a>
            </div>
        </div>

        @* Stats row — 4 columns *@
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="margin-bottom:6px;"><div style="width:30px;height:30px;border-radius:8px;background:#EEEDFE;color:#4B3BC7;display:flex;align-items:center;justify-content:center;font-size:14px;"><i class="ti ti-heart" aria-hidden="true"></i></div></div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.SavedListingsCount</div>
                <div style="font-size:11px;color:#888;">Saved listings</div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="margin-bottom:6px;"><div style="width:30px;height:30px;border-radius:8px;background:#FEF3E2;color:#B45309;display:flex;align-items:center;justify-content:center;font-size:14px;"><i class="ti ti-arrows-exchange" aria-hidden="true"></i></div></div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.ActiveOffersCount</div>
                <div style="font-size:11px;color:#888;">Active offers</div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="margin-bottom:6px;"><div style="width:30px;height:30px;border-radius:8px;background:#EBF5FF;color:#1E6FBF;display:flex;align-items:center;justify-content:center;font-size:14px;"><i class="ti ti-message-circle" aria-hidden="true"></i></div></div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.UnreadMessagesCount</div>
                <div style="font-size:11px;color:#888;">Unread messages</div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="margin-bottom:6px;"><div style="width:30px;height:30px;border-radius:8px;background:#EAF3DE;color:#27500A;display:flex;align-items:center;justify-content:center;font-size:14px;"><i class="ti ti-check" aria-hidden="true"></i></div></div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">0</div>
                <div style="font-size:11px;color:#888;">Completed trades</div>
            </div>
        </div>

        @* Saved listings preview *@
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
            <div style="font-size:13px;font-weight:500;color:#26215C;">Saved listings</div>
            <a href="/buyer/saved" style="font-size:11px;color:#4B3BC7;text-decoration:none;">View all →</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;">
            @if (Model.RecentSavedListings.Any())
            {
                @foreach (var listing in Model.RecentSavedListings.Take(3))
                {
                    <a href="/listings/@listing.ListingId" style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;overflow:hidden;text-decoration:none;color:inherit;display:block;">
                        <div style="background:#f0eefb;height:76px;display:flex;align-items:center;justify-content:center;color:#7F77DD;font-size:28px;position:relative;">
                            <i class="ti ti-photo" aria-hidden="true"></i>
                            <div style="position:absolute;top:6px;right:6px;color:#e74c3c;font-size:14px;"><i class="ti ti-heart-filled" aria-hidden="true"></i></div>
                        </div>
                        <div style="padding:8px 10px;">
                            <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@listing.Title</div>
                            <div style="font-size:12px;font-weight:500;color:#4B3BC7;margin-bottom:3px;">R @listing.Price.ToString("N0")</div>
                            <div style="font-size:10px;color:#888;">@listing.Condition · @((int)(DateTime.UtcNow - listing.CreatedAt).TotalDays)d ago</div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div style="grid-column:span 3;background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:24px;text-align:center;font-size:12px;color:#888;">
                    No saved listings yet. <a href="/listings/browse" style="color:#4B3BC7;">Start browsing →</a>
                </div>
            }
        </div>

        @* Active offers *@
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
            <div style="font-size:13px;font-weight:500;color:#26215C;">My active offers</div>
            <a href="/buyer/offers" style="font-size:11px;color:#4B3BC7;text-decoration:none;">View all →</a>
        </div>
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;overflow:hidden;margin-bottom:14px;">
            @if (Model.RecentOffers.Any())
            {
                @foreach (var offer in Model.RecentOffers)
                {
                    var statusStyle = offer.Status switch
                    {
                        "Accepted" => "background:#EAF3DE;color:#27500A;",
                        "Rejected" => "background:#FDECEA;color:#B91C1C;",
                        "Cancelled" => "background:#f5f4f9;color:#888;",
                        _ => "background:#FEF3E2;color:#B45309;"
                    };
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:0.5px solid #f0eefb;">
                        <div style="width:40px;height:40px;background:#f0eefb;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#7F77DD;font-size:16px;flex-shrink:0;">
                            <i class="ti ti-tag" aria-hidden="true"></i>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:2px;">@offer.ListingTitle</div>
                            <div style="font-size:11px;color:#888;">
                                @offer.OfferType offer
                                @if (offer.OfferAmount.HasValue)
                                {
                                    <span>· R @offer.OfferAmount.Value.ToString("N0")</span>
                                }
                            </div>
                        </div>
                        <span style="font-size:10px;border-radius:5px;padding:3px 8px;@statusStyle">@offer.Status</span>
                    </div>
                }
            }
            else
            {
                <div style="padding:20px;text-align:center;font-size:12px;color:#888;">
                    No active offers. <a href="/listings/browse" style="color:#4B3BC7;">Browse listings →</a>
                </div>
            }
        </div>

        @* Recent activity *@
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
            <div style="font-size:13px;font-weight:500;color:#26215C;">Recent activity</div>
        </div>
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;overflow:hidden;">
            <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;font-size:12px;color:#888;justify-content:center;">
                Activity from messages, offers, and price drops will appear here.
            </div>
        </div>

    </div>
</div>