@model VarsityTrade.Web.Models.Seller.SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Dashboard";
    ViewData["SidebarPage"] = "seller-dashboard";
    Layout = "_Layout";
    var firstName = Context.Session.GetString("FirstName") ?? "there";
}

<div class="vt-body">
    
    @await Html.PartialAsync("_SidebarFull")

    <div class="vt-main">

        @* Switch bar — matches wireframe exactly *@
        <div style="background:#EEEDFE;border:0.5px solid #AFA9EC;border-radius:10px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div style="font-size:12px;color:#3C3489;">
                You are viewing your <b>Seller Dashboard</b>
            </div>
            <a href="/seller/switch-to-buyer" style="background:#4B3BC7;color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:11px;font-weight:500;display:flex;align-items:center;gap:5px;text-decoration:none;">
                <i class="ti ti-shopping-cart" aria-hidden="true"></i> Switch to buyer view
            </a>
        </div>

        @* Welcome bar *@
        <div style="background:linear-gradient(135deg,#4B3BC7,#26215C);border-radius:12px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div>
                <div style="background:rgba(255,255,255,0.15);color:#fff;font-size:10px;border-radius:5px;padding:3px 8px;display:inline-flex;align-items:center;gap:4px;margin-bottom:6px;">
                    <i class="ti ti-store" aria-hidden="true"></i> Seller account
                </div>
                <div style="font-size:15px;font-weight:500;color:#fff;margin-bottom:2px;">Good day, @firstName 👋</div>
                <div style="font-size:11px;color:#AFA9EC;">@Model.StoreName</div>
            </div>
            <div style="display:flex;gap:8px;">
                <a href="/seller/profile" style="background:rgba(255,255,255,0.15);color:#fff;border:none;border-radius:6px;padding:7px 12px;font-size:11px;display:flex;align-items:center;gap:5px;text-decoration:none;">
                    <i class="ti ti-eye" aria-hidden="true"></i> View my profile
                </a>
                <a href="/seller/listings/create" style="background:#fff;color:#4B3BC7;border:none;border-radius:6px;padding:7px 14px;font-size:11px;font-weight:500;display:flex;align-items:center;gap:5px;text-decoration:none;">
                    <i class="ti ti-plus" aria-hidden="true"></i> New listing
                </a>
            </div>
        </div>

        @* Stats grid — 4 columns matching wireframe *@
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                    <div style="width:30px;height:30px;border-radius:8px;background:#EEEDFE;color:#4B3BC7;display:flex;align-items:center;justify-content:center;font-size:14px;">
                        <i class="ti ti-list" aria-hidden="true"></i>
                    </div>
                </div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.ActiveListingsCount</div>
                <div style="font-size:11px;color:#888;">Active listings</div>
                <div style="font-size:10px;color:#27500A;display:flex;align-items:center;gap:2px;margin-top:2px;">
                    <i class="ti ti-trending-up" aria-hidden="true"></i> Your listings
                </div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                    <div style="width:30px;height:30px;border-radius:8px;background:#EAF3DE;color:#27500A;display:flex;align-items:center;justify-content:center;font-size:14px;">
                        <i class="ti ti-check" aria-hidden="true"></i>
                    </div>
                </div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.TotalSales</div>
                <div style="font-size:11px;color:#888;">Completed sales</div>
                <div style="font-size:10px;color:#27500A;display:flex;align-items:center;gap:2px;margin-top:2px;">
                    <i class="ti ti-trending-up" aria-hidden="true"></i> All time
                </div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                    <div style="width:30px;height:30px;border-radius:8px;background:#FEF3E2;color:#B45309;display:flex;align-items:center;justify-content:center;font-size:14px;">
                        <i class="ti ti-arrows-exchange" aria-hidden="true"></i>
                    </div>
                </div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.PendingOffersCount</div>
                <div style="font-size:11px;color:#888;">Pending offers</div>
                <div style="font-size:10px;color:#B45309;display:flex;align-items:center;gap:2px;margin-top:2px;">
                    <i class="ti ti-clock" aria-hidden="true"></i> Awaiting response
                </div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:12px 14px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                    <div style="width:30px;height:30px;border-radius:8px;background:#EBF5FF;color:#1E6FBF;display:flex;align-items:center;justify-content:center;font-size:14px;">
                        <i class="ti ti-message-circle" aria-hidden="true"></i>
                    </div>
                </div>
                <div style="font-size:20px;font-weight:500;color:#26215C;">@Model.UnreadMessagesCount</div>
                <div style="font-size:11px;color:#888;">Unread messages</div>
                <div style="font-size:10px;color:#1E6FBF;display:flex;align-items:center;gap:2px;margin-top:2px;">
                    <i class="ti ti-clock" aria-hidden="true"></i> Reply promptly
                </div>
            </div>
        </div>

        @* Two-column: Recent listings + Pending offers *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">

            @* Recent listings *@
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                    <div style="font-size:13px;font-weight:500;color:#26215C;">Recent listings</div>
                    <a href="/seller/listings" style="font-size:11px;color:#4B3BC7;text-decoration:none;">Manage all →</a>
                </div>
                @if (Model.RecentListings.Any())
                {
                    @foreach (var listing in Model.RecentListings)
                    {
                        var daysAgo = (int)(DateTime.UtcNow - listing.CreatedAt).TotalDays;
                        var timeAgo = daysAgo == 0 ? "Today" : daysAgo == 1 ? "1d ago" : $"{daysAgo}d ago";
                        <a href="/listings/@listing.ListingId"
                           style="display:flex;
                            align-items:center;
                            gap:10px;
                            padding:8px 0;
                            border-bottom:0.5px solid #f0eefb;
                            text-decoration:none;
                            color:inherit;
                            cursor:pointer;">

                            <div style="width:36px;
                                height:36px;
                                background:#EEEDFE;
                                border-radius:6px;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                color:#4B3BC7;
                                font-size:16px;
                                flex-shrink:0;">

                                @if (!string.IsNullOrWhiteSpace(
                                    listing.CoverImageUrl))
                                {
                                    <img src="@listing.CoverImageUrl"
                                         alt="@listing.Title"
                                         style="width:100%;
                                    height:100%;
                                    object-fit:cover;
                                    border-radius:6px;" />
                                }
                                else
                                {
                                    <i class="ti ti-photo"
                                       aria-hidden="true"></i>
                                }

                            </div>

                            <div style="flex:1;min-width:0;">

                                <div style="font-size:12px;
                                    font-weight:500;
                                    color:#26215C;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    text-overflow:ellipsis;">
                                    @listing.Title
                                </div>

                                <div style="font-size:10px;color:#888;">
                                    @listing.CategoryName · @timeAgo
                                </div>

                            </div>

                            <div style="display:flex;
                                flex-direction:column;
                                align-items:flex-end;
                                gap:3px;">

                                <div style="font-size:12px;
                                    font-weight:500;
                                    color:#4B3BC7;">
                                    R @listing.Price.ToString("N0")
                                </div>

                                @{
                                    var statusStyle =
                                        listing.Status == "Sold"
                                            ? "background:#f5f4f9;color:#888;"
                                            : "background:#EAF3DE;color:#27500A;";
                                }

                                <span style="font-size:9px;
                                    border-radius:4px;
                                    padding:2px 6px;
                                    @statusStyle">
                                    @listing.Status
                                </span>

                            </div>

                        </a>
                    }
                }
                else
                {
                    <p style="font-size:12px;color:#888;text-align:center;padding:16px 0;">
                        No listings yet. <a href="/seller/listings/create" style="color:#4B3BC7;">Create one →</a>
                    </p>
                }
            </div>

            @* Pending offers *@
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                    <div style="font-size:13px;font-weight:500;color:#26215C;">Pending offers</div>
                    <a href="/seller/offers" style="font-size:11px;color:#4B3BC7;text-decoration:none;">View all →</a>
                </div>
                @if (Model.PendingOffers.Any())
                {
                    @foreach (var offer in Model.PendingOffers)
                    {
                        var initials = $"{offer.BuyerFirstName[0]}{offer.BuyerLastName[0]}".ToUpper();
                        <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:0.5px solid #f0eefb;">
                            <div style="width:30px;height:30px;border-radius:50%;background:#EEEDFE;color:#4B3BC7;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;flex-shrink:0;">
                                @initials
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:12px;font-weight:500;color:#26215C;">@offer.BuyerFirstName @offer.BuyerLastName — @offer.ListingTitle</div>
                                <div style="font-size:10px;color:#888;">
                                    @if (offer.OfferAmount.HasValue)
                                    {
                                        <span>Offering: R @offer.OfferAmount.Value.ToString("N0") cash</span>
                                    }
                                    else
                                    {
                                        <span>Trade offer</span>
                                    }
                                </div>
                            </div>
                            <div style="display:flex;gap:5px;">
                                <form asp-controller="Seller" asp-action="AcceptOffer" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="offerId" value="@offer.OfferId" />
                                    <button type="submit" style="background:#EAF3DE;color:#27500A;border:none;border-radius:5px;padding:4px 8px;font-size:10px;cursor:pointer;">
                                        <i class="ti ti-check" aria-hidden="true"></i>
                                    </button>
                                </form>
                                <form asp-controller="Seller" asp-action="RejectOffer" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="offerId" value="@offer.OfferId" />
                                    <button type="submit" style="background:#FDECEA;color:#B91C1C;border:none;border-radius:5px;padding:4px 8px;font-size:10px;cursor:pointer;">
                                        <i class="ti ti-x" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:12px;color:#888;text-align:center;padding:16px 0;">No pending offers.</p>
                }
            </div>
        </div>

        @* Recent activity *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                <div style="font-size:13px;font-weight:500;color:#26215C;">Recent activity</div>
            </div>
            <div style="font-size:12px;color:#888;text-align:center;padding:16px 0;">
                Activity from messages, offers, and reviews will appear here.
            </div>
        </div>

    </div>
</div>