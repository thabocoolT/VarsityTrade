@model VarsityTrade.Web.Models.Seller.ActivateSellerViewModel
@{
    ViewData["Title"] = "Activate Seller Profile";
    ViewData["SidebarPage"] = "activate";
    Layout = "_Layout";
    var suburb    = Context.Session.GetString("Suburb") ?? "";
    var residence = Context.Session.GetString("ResidenceName") ?? "";
    var uniName   = Context.Session.GetString("UniversityName") ?? "Your University";
}

<div style="display:grid;grid-template-columns:44px 1fr;gap:12px;padding:16px 24px;align-items:start;">
    @await Html.PartialAsync("_Sidebar")

    <div style="display:grid;grid-template-columns:1fr 280px;gap:14px;align-items:start;">
        <div>
            @* Hero *@
            <div style="background:linear-gradient(135deg,#4B3BC7,#26215C);border-radius:12px;padding:20px 24px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <div style="background:rgba(255,255,255,0.15);color:#fff;font-size:10px;border-radius:5px;padding:3px 8px;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
                        <i class="ti ti-store" aria-hidden="true"></i> One-time setup
                    </div>
                    <div style="font-size:18px;font-weight:500;color:#fff;margin-bottom:6px;">Activate your seller profile</div>
                    <div style="font-size:12px;color:#AFA9EC;line-height:1.6;max-width:360px;">Set up your seller profile once and start listing items for students at your campus. Free, fast, and easy.</div>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;">
                    <div style="text-align:center;background:rgba(255,255,255,0.1);border-radius:8px;padding:8px 14px;">
                        <div style="font-size:16px;font-weight:500;color:#fff;">Free</div>
                        <div style="font-size:10px;color:#AFA9EC;">Always</div>
                    </div>
                    <div style="text-align:center;background:rgba(255,255,255,0.1);border-radius:8px;padding:8px 14px;">
                        <div style="font-size:16px;font-weight:500;color:#fff;">&lt;2 min</div>
                        <div style="font-size:10px;color:#AFA9EC;">Setup time</div>
                    </div>
                </div>
            </div>

            @* Step indicator *@
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;overflow:hidden;margin-bottom:14px;display:flex;">
                @foreach (var (num, lbl, active) in new[] { ("1","Seller details",true), ("2","Preferences",false), ("3","Confirm & activate",false) })
                {
                    <div style="flex:1;padding:10px 14px;display:flex;align-items:center;gap:8px;@(num!="3"?"border-right:0.5px solid #e0ddf5;":"")">
                        <div style="width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;flex-shrink:0;@(active?"background:#4B3BC7;color:#fff;box-shadow:0 0 0 3px #EEEDFE;":"background:#f5f4f9;color:#aaa;border:0.5px solid #ddd;")">@num</div>
                        <span style="font-size:11px;@(active?"color:#4B3BC7;font-weight:500;":"color:#888;")">@lbl</span>
                    </div>
                }
            </div>

            <form asp-action="Activate" asp-controller="Seller" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" style="background:#FDECEA;border:0.5px solid #F5A8A8;border-radius:7px;padding:8px 10px;font-size:11px;color:#B91C1C;margin-bottom:12px;"></div>

                @* Step 1 — Seller details *@
                <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:16px;margin-bottom:12px;">
                    <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:12px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;display:flex;align-items:center;gap:6px;">
                        <i class="ti ti-store" aria-hidden="true"></i> Step 1 — Seller details
                    </div>
                    <div style="margin-bottom:10px;">
                        <div style="font-size:11px;color:#555;margin-bottom:4px;display:flex;align-items:center;gap:3px;">Seller display name <span style="color:#e74c3c;">*</span></div>
                        <input asp-for="StoreName" type="text" placeholder="e.g. Thabo's Shop"
                               style="width:100%;border:0.5px solid #4B3BC7;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                        <div style="font-size:10px;color:#888;margin-top:3px;">This is the name buyers will see on your listings and profile.</div>
                        <span asp-validation-for="StoreName" style="font-size:10px;color:#e74c3c;display:block;"></span>
                    </div>
                    <div style="margin-bottom:10px;">
                        <div style="font-size:11px;color:#555;margin-bottom:4px;">Seller bio</div>
                        <textarea asp-for="SellerBio" rows="3" placeholder="Tell buyers a bit about yourself and what you sell..."
                                  style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;resize:none;"></textarea>
                        <div style="font-size:10px;color:#888;margin-top:3px;">Shown on your public seller profile page.</div>
                    </div>
                    <div style="margin-bottom:10px;">
                        <div style="font-size:11px;color:#555;margin-bottom:4px;display:flex;align-items:center;gap:3px;">University <span style="color:#e74c3c;">*</span></div>
                        <div style="background:#f5f4f9;border:0.5px solid #e0ddf5;border-radius:7px;padding:7px 10px;font-size:11px;color:#888;display:flex;align-items:center;gap:5px;margin-bottom:6px;">
                            <i class="ti ti-lock" aria-hidden="true"></i> Automatically set to your registered university — @uniName.
                        </div>
                        <input type="text" value="@uniName" disabled
                               style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#aaa;background:#f5f4f9;outline:none;" />
                    </div>
                    <div>
                        <div style="font-size:11px;color:#555;margin-bottom:4px;display:flex;align-items:center;gap:3px;">Contact preference <span style="color:#e74c3c;">*</span></div>
                        <select style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;">
                            <option>In-app messaging only</option>
                            <option>Phone and in-app messaging</option>
                            <option>WhatsApp and in-app messaging</option>
                        </select>
                        <div style="font-size:10px;color:#888;margin-top:3px;">How buyers can reach you about your listings.</div>
                    </div>
                </div>

                @* Step 2 — Pickup & delivery *@
                <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:16px;margin-bottom:12px;">
                    <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:12px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;display:flex;align-items:center;gap:6px;">
                        <i class="ti ti-map-pin" aria-hidden="true"></i> Step 2 — Pickup & delivery preferences
                    </div>
                    <div style="background:#EEEDFE;border:0.5px solid #AFA9EC;border-radius:7px;padding:7px 10px;font-size:11px;color:#3C3489;display:flex;align-items:flex-start;gap:5px;margin-bottom:12px;">
                        <i class="ti ti-info-circle" aria-hidden="true" style="font-size:14px;flex-shrink:0;margin-top:1px;"></i>
                        Your suburb and res are pulled from your profile. You can update them in your profile settings.
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
                        <div>
                            <div style="font-size:11px;color:#555;margin-bottom:4px;">Suburb</div>
                            <input type="text" value="@suburb" disabled
                                   style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#aaa;background:#f5f4f9;outline:none;" />
                        </div>
                        <div>
                            <div style="font-size:11px;color:#555;margin-bottom:4px;">Residence</div>
                            <input type="text" value="@residence" disabled
                                   style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#aaa;background:#f5f4f9;outline:none;" />
                        </div>
                    </div>

                    @* Toggle rows *@
                    @foreach (var (propName, label, sub, defaultOn) in new[] {
                        ("CampusPickup",      "Campus pickup available",  "Buyers can collect from your res or agreed campus spot",                          true),
                        ("DeliveryAvailable", "Delivery available",       "You can deliver to nearby residences within your campus area",                    false),
                        ("OpenToTrades",      "Open to trade offers",     "Allow buyers to propose trade or exchange offers on your listings",               true),
                    })
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:0.5px solid #f0eefb;">
                            <div>
                                <div style="font-size:12px;color:#26215C;font-weight:500;">@label</div>
                                <div style="font-size:10px;color:#888;margin-top:2px;">@sub</div>
                            </div>
                            <label style="position:relative;width:36px;height:20px;flex-shrink:0;cursor:pointer;">
                                <input type="checkbox" name="@propName" value="true" @(defaultOn?"checked":"")
                                       style="opacity:0;width:0;height:0;position:absolute;" />
                                <span style="position:absolute;inset:0;background:@(defaultOn?"#4B3BC7":"#ddd");border-radius:10px;transition:0.2s;"></span>
                                <span style="position:absolute;width:16px;height:16px;background:#fff;border-radius:50%;top:2px;@(defaultOn?"right:2px;":"left:2px;")transition:0.2s;"></span>
                            </label>
                        </div>
                    }
                </div>

                @* Step 3 — Confirm *@
                <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:16px;margin-bottom:12px;">
                    <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:12px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;display:flex;align-items:center;gap:6px;">
                        <i class="ti ti-circle-check" aria-hidden="true"></i> Step 3 — Confirm & activate
                    </div>
                    <div style="background:#EEEDFE;border:0.5px solid #AFA9EC;border-radius:7px;padding:7px 10px;font-size:11px;color:#3C3489;display:flex;align-items:flex-start;gap:5px;margin-bottom:12px;">
                        <i class="ti ti-shield-check" aria-hidden="true" style="font-size:14px;flex-shrink:0;margin-top:1px;"></i>
                        By activating your seller profile you agree to the Varsity Trade seller guidelines. Your listings will only be visible to students at your university.
                    </div>
                    <div style="display:flex;gap:8px;">
                        <button type="submit" style="background:#4B3BC7;color:#fff;border:none;border-radius:7px;padding:10px 24px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:6px;cursor:pointer;">
                            <i class="ti ti-store" aria-hidden="true"></i> Activate seller profile
                        </button>
                        <a href="/buyer" style="background:#fff;color:#666;border:0.5px solid #ddd;border-radius:7px;padding:10px 16px;font-size:12px;cursor:pointer;text-decoration:none;display:flex;align-items:center;">Cancel</a>
                    </div>
                </div>
            </form>
        </div>

        @* Right sidebar *@
        <div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;margin-bottom:12px;">
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;display:flex;align-items:center;gap:5px;">
                    <i class="ti ti-star" aria-hidden="true"></i> Why become a seller?
                </div>
                @foreach (var (icon, title, sub) in new[] {
                    ("ti-cash",            "Turn your stuff into cash",     "List items you no longer need and earn money from fellow students."),
                    ("ti-shield-check",    "Campus-safe marketplace",       "Only students at your university see and buy your listings."),
                    ("ti-chart-bar",       "Seller dashboard",              "Manage all your listings, offers, and messages in one place."),
                    ("ti-arrows-exchange", "Accept trade offers",           "Receive and respond to exchange offers from buyers at your campus."),
                })
                {
                    <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
                        <div style="width:28px;height:28px;background:#EEEDFE;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#4B3BC7;font-size:13px;flex-shrink:0;">
                            <i class="ti @icon" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div style="font-size:11px;font-weight:500;color:#26215C;margin-bottom:1px;">@title</div>
                            <div style="font-size:10px;color:#888;line-height:1.4;">@sub</div>
                        </div>
                    </div>
                }
            </div>

            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;display:flex;align-items:center;gap:5px;">
                    <i class="ti ti-file-text" aria-hidden="true"></i> Seller rules
                </div>
                @foreach (var (icon, color, rule) in new[] {
                    ("ti-check","#4B3BC7","Only list items you personally own"),
                    ("ti-check","#4B3BC7","Describe items honestly and accurately"),
                    ("ti-check","#4B3BC7","Meet buyers on campus in public areas"),
                    ("ti-check","#4B3BC7","No vehicles, industrial or restricted items"),
                    ("ti-check","#4B3BC7","Respond to buyer messages promptly"),
                    ("ti-x",   "#e74c3c","No scamming, fraud or misrepresentation"),
                })
                {
                    <div style="display:flex;align-items:flex-start;gap:6px;font-size:11px;color:#555;margin-bottom:6px;line-height:1.4;">
                        <i class="ti @icon" aria-hidden="true" style="color:@color;font-size:12px;margin-top:1px;flex-shrink:0;"></i> @rule
                    </div>
                }
            </div>
        </div>
    </div>
</div>