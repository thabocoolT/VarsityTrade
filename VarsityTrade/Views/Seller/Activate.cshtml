@model VarsityTrade.Web.Models.Seller.ActivateSellerViewModel
@{
    ViewData["Title"] = "Activate Seller Profile";
    Layout = "_Layout";
}

<div class="vt-body-no-sidebar" style="max-width:560px;margin:40px auto;">
    <div class="vt-card">
        <div style="text-align:center;margin-bottom:24px;">
            <div style="width:48px;height:48px;background:var(--vt-primary);border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:22px;color:#fff;">
                <i class="ti ti-store" aria-hidden="true"></i>
            </div>
            <h1 style="font-size:20px;font-weight:500;margin-bottom:4px;">Activate your seller profile</h1>
            <p style="font-size:12px;color:var(--vt-text-muted);">Start selling to students at your university in minutes.</p>
        </div>

        <form asp-action="Activate" asp-controller="Seller" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="vt-form-error" style="margin-bottom:12px;"></div>

            <div class="vt-form-group">
                <label class="vt-form-label">Store name</label>
                <input asp-for="StoreName" class="vt-form-input" placeholder="e.g. Thabo's Tech Shop" />
                <div class="vt-form-hint">This is the name buyers will see on your listings.</div>
            </div>

            <div class="vt-form-group">
                <label class="vt-form-label">Seller bio (optional)</label>
                <textarea asp-for="SellerBio" class="vt-form-input" rows="3"
                          placeholder="Tell buyers a bit about yourself and what you sell..."></textarea>
            </div>

            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:16px;">
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <input asp-for="CampusPickup" type="checkbox" style="width:16px;height:16px;" />
                    <div>
                        <div style="font-weight:500;">Campus pickup available</div>
                        <div style="font-size:11px;color:var(--vt-text-muted);">Buyers can collect from your res or agreed campus spot</div>
                    </div>
                </label>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <input asp-for="DeliveryAvailable" type="checkbox" style="width:16px;height:16px;" />
                    <div>
                        <div style="font-weight:500;">Delivery available</div>
                        <div style="font-size:11px;color:var(--vt-text-muted);">You can deliver to nearby residences</div>
                    </div>
                </label>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <input asp-for="OpenToTrades" type="checkbox" style="width:16px;height:16px;" />
                    <div>
                        <div style="font-weight:500;">Open to trade offers</div>
                        <div style="font-size:11px;color:var(--vt-text-muted);">Allow buyers to propose trade or exchange offers</div>
                    </div>
                </label>
            </div>

            <button type="submit" class="vt-btn vt-btn-primary" style="width:100%;justify-content:center;">
                <i class="ti ti-rocket" aria-hidden="true"></i> Activate seller profile
            </button>
        </form>
    </div>
</div>