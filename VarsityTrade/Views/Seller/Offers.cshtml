@{
    ViewData["Title"] = "Received Offers";
    Layout = "_Layout";
    var offers = ViewBag.Offers as List<VarsityTrade.Web.Models.Seller.ReceivedOfferViewModel> ?? new();
    var activeFilter = ViewBag.ActiveFilter as string ?? "All";
}

<div class="vt-body">
    @await Html.PartialAsync("_Sidebar")

    <div>
        <div class="vt-card-title" style="margin-bottom:14px;">
            <i class="ti ti-tag" aria-hidden="true"></i> Received Offers
        </div>

        <div class="vt-filter-tabs">
            @foreach (var f in new[] { "All", "Pending", "Accepted", "Rejected" })
            {
                <a href="/seller/offers?filter=@f"
                   class="vt-filter-tab @(activeFilter == f ? "active" : "")">@f</a>
            }
        </div>

        @if (offers.Any())
        {
            @foreach (var offer in offers)
            {
                <div class="vt-card" style="margin-bottom:10px;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
                        <div style="flex:1;">
                            <div style="font-size:14px;font-weight:500;margin-bottom:4px;">@offer.ListingTitle</div>
                            <div style="font-size:12px;color:var(--vt-text-muted);margin-bottom:4px;">
                                <i class="ti ti-user" aria-hidden="true"></i>
                                @offer.BuyerFirstName @offer.BuyerLastName
                                · @offer.BuyerSuburb
                                @if (!string.IsNullOrEmpty(offer.BuyerResidenceName))
                                {
                                    <span>· @offer.BuyerResidenceName</span>
                                }
                            </div>
                            <div style="font-size:13px;color:var(--vt-primary);margin-bottom:4px;">
                                @offer.OfferType offer
                                @if (offer.OfferAmount.HasValue)
                                {
                                    <span>— R @offer.OfferAmount.Value.ToString("N0")</span>
                                }
                            </div>
                            @if (offer.OfferItems.Any())
                            {
                                <div style="font-size:11px;color:var(--vt-text-muted);">
                                    Trade items: @string.Join(", ", offer.OfferItems.Select(i => i.Title))
                                </div>
                            }
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
                            @{
                                var badgeClass = offer.Status switch
                                {
                                    "Accepted" => "vt-badge-success",
                                    "Rejected" => "vt-badge-danger",
                                    _ => "vt-badge-warning"
                                };
                            }
                            <span class="vt-badge @badgeClass">@offer.Status</span>
                            @if (offer.Status == "Pending")
                            {
                                <div style="display:flex;gap:6px;">
                                    <form asp-controller="Seller" asp-action="AcceptOffer" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="offerId" value="@offer.OfferId" />
                                        <button type="submit" class="vt-btn vt-btn-success" style="font-size:11px;">
                                            <i class="ti ti-check" aria-hidden="true"></i> Accept
                                        </button>
                                    </form>
                                    <form asp-controller="Seller" asp-action="RejectOffer" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="offerId" value="@offer.OfferId" />
                                        <button type="submit" class="vt-btn vt-btn-danger" style="font-size:11px;">
                                            <i class="ti ti-x" aria-hidden="true"></i> Reject
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="vt-card" style="text-align:center;padding:40px;">
                <i class="ti ti-tag" aria-hidden="true" style="font-size:40px;color:var(--vt-primary-muted);display:block;margin-bottom:12px;"></i>
                <div style="font-size:14px;font-weight:500;margin-bottom:6px;">No offers received yet</div>
                <p style="font-size:12px;color:var(--vt-text-muted);">Offers from buyers will appear here once they are submitted.</p>
            </div>
        }
    </div>
</div>