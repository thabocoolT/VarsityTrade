@model VarsityTrade.Web.Models.Buyer.InboxViewModel

@{
    ViewData["Title"] = "Seller Inbox";
    ViewData["SidebarPage"] = "seller-inbox";
    Layout = "_Layout";

    var conversations = Model.Conversations
        .OrderByDescending(c => c.LastMessageAt ?? c.CreatedAt)
        .ToList();

    var unreadCount = Model.UnreadCount;
}

<style>
    .seller-inbox-main {
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
        gap: 12px;
        align-items: start;
    }

    .vt-inbox-panel,
    .vt-thread-panel {
        background: #fff;
        border: 0.5px solid #e0ddf5;
        border-radius: 12px;
        overflow: hidden;
        min-width: 0;
    }

    .vt-inbox-header {
        padding: 12px 14px;
        border-bottom: 0.5px solid #e0ddf5;
    }

    .vt-inbox-title {
        font-size: 13px;
        font-weight: 500;
        color: #26215C;
        margin-bottom: 8px;
    }

    .vt-inbox-search {
        display: flex;
        align-items: center;
        border: 0.5px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
        background: #f5f4f9;
    }

        .vt-inbox-search input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            padding: 6px 10px;
            font-size: 11px;
            background: transparent;
            color: #26215C;
        }

        .vt-inbox-search i {
            padding: 0 8px;
            color: #aaa;
            font-size: 14px;
        }

    .vt-inbox-tabs {
        display: flex;
        border-bottom: 0.5px solid #e0ddf5;
    }

    .vt-inbox-tab {
        flex: 1;
        border: 0;
        background: transparent;
        padding: 8px;
        font-family: inherit;
        font-size: 11px;
        color: #888;
        text-align: center;
        cursor: pointer;
        border-bottom: 2px solid transparent;
    }

        .vt-inbox-tab.active {
            color: #4B3BC7;
            border-bottom-color: #4B3BC7;
            font-weight: 500;
        }

    .vt-thread {
        width: 100%;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 14px;
        border: 0;
        border-bottom: 0.5px solid #f0eefb;
        text-align: left;
        font-family: inherit;
        background: #fff;
        color: inherit;
        text-decoration: none;
        transition: background 0.15s ease;
    }

        .vt-thread:hover {
            background: #f8f7fd;
        }

        .vt-thread:focus-visible {
            outline: 2px solid #4B3BC7;
            outline-offset: -2px;
        }

        .vt-thread.unread .vt-thread-name {
            font-weight: 600;
            color: #26215C;
        }

    .vt-thread-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #4B3BC7;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 500;
        flex-shrink: 0;
    }

    .vt-thread-info {
        flex: 1;
        min-width: 0;
    }

    .vt-thread-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 2px;
    }

    .vt-thread-name {
        min-width: 0;
        font-size: 12px;
        color: #555;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vt-thread-time {
        font-size: 10px;
        color: #aaa;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .vt-thread-listing {
        font-size: 10px;
        color: #4B3BC7;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vt-thread-preview {
        font-size: 11px;
        color: #888;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vt-thread-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4B3BC7;
        flex-shrink: 0;
        margin-top: 5px;
    }

    .vt-no-messages {
        padding: 32px;
        text-align: center;
        font-size: 12px;
        color: #888;
    }

        .vt-no-messages i {
            font-size: 32px;
            color: #AFA9EC;
            display: block;
            margin-bottom: 8px;
        }

    .vt-thread-panel {
        min-height: 500px;
        display: flex;
        flex-direction: column;
    }

    .vt-thread-empty {
        flex: 1;
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .vt-thread-empty-content {
        padding: 40px;
    }

        .vt-thread-empty-content i {
            font-size: 40px;
            color: #AFA9EC;
            display: block;
            margin-bottom: 12px;
        }

    .vt-thread-empty-title {
        font-size: 14px;
        font-weight: 500;
        color: #26215C;
        margin-bottom: 6px;
    }

    .vt-thread-empty-text {
        font-size: 12px;
        color: #888;
    }

    .vt-inbox-empty {
        padding: 32px 20px;
        text-align: center;
        color: #888;
        font-size: 12px;
    }

        .vt-inbox-empty i {
            display: block;
            margin-bottom: 8px;
            font-size: 32px;
            color: #AFA9EC;
        }

    @@media (max-width: 900px) {
        .seller-inbox-main {
            grid-template-columns: 1fr;
        }

        .vt-thread-panel {
            min-height: 300px;
        }

        .vt-thread-empty {
            min-height: 300px;
        }
    }
</style>

<div class="vt-body">

    @await Html.PartialAsync("_Sidebar")

    <div class="vt-main seller-inbox-main">

        <!-- Seller conversation list -->
        <div class="vt-inbox-panel">

            <div class="vt-inbox-header">

                <div class="vt-inbox-title">
                    Seller inbox

                    <span style="font-size:10px; color:#888; font-weight:400;">
                        (@conversations.Count threads)
                    </span>
                </div>

                <div class="vt-inbox-search">
                    <i class="ti ti-search" aria-hidden="true"></i>

                    <input type="text"
                           id="conversationSearch"
                           placeholder="Search conversations..."
                           autocomplete="off"
                           aria-label="Search conversations" />
                </div>

            </div>

            <div class="vt-inbox-tabs">

                <button type="button"
                        class="vt-inbox-tab active"
                        data-filter="all">
                    All (@conversations.Count)
                </button>

                <button type="button"
                        class="vt-inbox-tab"
                        data-filter="unread">
                    Unread (@unreadCount)
                </button>

            </div>

            @if (conversations.Any())
            {
                <div id="conversationList">

                    @foreach (var conv in conversations)
                    {
                        var isUnread = conv.UnreadCount > 0;

                        var buyerName =
                            $"{conv.BuyerFirstName} {conv.BuyerLastName}".Trim();

                        if (string.IsNullOrWhiteSpace(buyerName))
                        {
                            buyerName = "Buyer";
                        }

                        var buyerInitials = "";

                        if (!string.IsNullOrWhiteSpace(conv.BuyerFirstName))
                        {
                            buyerInitials += conv.BuyerFirstName
                                .Substring(0, 1)
                                .ToUpperInvariant();
                        }

                        if (!string.IsNullOrWhiteSpace(conv.BuyerLastName))
                        {
                            buyerInitials += conv.BuyerLastName
                                .Substring(0, 1)
                                .ToUpperInvariant();
                        }

                        if (string.IsNullOrWhiteSpace(buyerInitials))
                        {
                            buyerInitials = "?";
                        }

                        var timeAgo = "";

                        if (conv.LastMessageAt.HasValue)
                        {
                            var elapsed =
                                DateTime.UtcNow - conv.LastMessageAt.Value;

                            if (elapsed.TotalMinutes < 60)
                            {
                                timeAgo = $"{Math.Max(1, (int)elapsed.TotalMinutes)}m";
                            }
                            else if (elapsed.TotalHours < 24)
                            {
                                timeAgo = $"{Math.Max(1, (int)elapsed.TotalHours)}h";
                            }
                            else if (elapsed.TotalDays < 7)
                            {
                                timeAgo = $"{Math.Max(1, (int)elapsed.TotalDays)}d";
                            }
                            else
                            {
                                timeAgo = conv.LastMessageAt.Value.ToString("dd MMM");
                            }
                        }
                        else
                        {
                            timeAgo = conv.CreatedAt.ToString("dd MMM");
                        }

                        var searchText =
                            $"{buyerName} {conv.ListingTitle} {conv.LastMessageContent}";

                        <a asp-controller="Buyer"
                           asp-action="Conversation"
                           asp-route-id="@conv.ConversationId"
                           class="vt-thread @(isUnread ? "unread" : "")"
                           data-unread="@(isUnread ? "true" : "false")"
                           data-search="@searchText">

                            <div class="vt-thread-avatar">
                                @buyerInitials
                            </div>

                            <div class="vt-thread-info">

                                <div class="vt-thread-top">

                                    <span class="vt-thread-name">
                                        @buyerName
                                    </span>

                                    <span class="vt-thread-time">
                                        @timeAgo
                                    </span>

                                </div>

                                <div class="vt-thread-listing">
                                    Re: @conv.ListingTitle
                                </div>

                                <div class="vt-thread-preview">
                                    @(conv.LastMessageContent ?? "Started conversation")
                                </div>

                            </div>

                            @if (isUnread)
                            {
                                <div class="vt-thread-dot"
                                     aria-label="Unread messages"></div>
                            }

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="vt-no-messages">
                    <i class="ti ti-message-circle" aria-hidden="true"></i>
                    No messages yet
                </div>
            }

            <div id="conversationSearchEmpty"
                 class="vt-inbox-empty"
                 hidden>
                <i class="ti ti-search" aria-hidden="true"></i>
                No conversations match your search.
            </div>

        </div>

        <!-- The conversation is displayed on the shared conversation page -->
        <div class="vt-thread-panel">

            <div class="vt-thread-empty">

                <div class="vt-thread-empty-content">

                    <i class="ti ti-message-circle" aria-hidden="true"></i>

                    <div class="vt-thread-empty-title">
                        Your conversations
                    </div>

                    <div class="vt-thread-empty-text">
                        Select a conversation from the list to view messages
                        and reply to the buyer.
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById('conversationSearch');
            const threads = Array.from(document.querySelectorAll('.vt-thread'));
            const tabs = Array.from(document.querySelectorAll('.vt-inbox-tab'));
            const searchEmpty = document.getElementById('conversationSearchEmpty');

            let activeFilter = 'all';

            function applyFilters() {
                const query = (searchInput?.value || '').trim().toLowerCase();
                let visibleCount = 0;

                threads.forEach(thread => {
                    const searchText = (thread.dataset.search || '').toLowerCase();
                    const isUnread = thread.dataset.unread === 'true';

                    const matchesSearch =
                        !query || searchText.includes(query);

                    const matchesFilter =
                        activeFilter !== 'unread' || isUnread;

                    const visible = matchesSearch && matchesFilter;

                    thread.hidden = !visible;

                    if (visible) {
                        visibleCount++;
                    }
                });

                if (searchEmpty) {
                    searchEmpty.hidden = visibleCount !== 0;
                }
            }

            searchInput?.addEventListener('input', applyFilters);

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    activeFilter = tab.dataset.filter || 'all';

                    tabs.forEach(item => {
                        const active = item === tab;
                        item.classList.toggle('active', active);
                        item.setAttribute('aria-pressed', active.toString());
                    });

                    applyFilters();
                });
            });

            applyFilters();
        })();
    </script>
}