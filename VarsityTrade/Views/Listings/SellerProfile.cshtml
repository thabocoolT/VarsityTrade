@{
    ViewData["Title"] = "Seller Profile";
    Layout = "_Layout";
    var profile   = ViewBag.Profile as dynamic;
    var reviews   = ViewBag.Reviews  as List<VarsityTrade.Web.Models.Reviews.ReviewViewModel> ?? new();
    var avgRating = (double)(ViewBag.AvgRating ?? 0.0);
    var storeName = (string)(profile?.storeName ?? "Seller");
    var storeInitial = storeName.Length > 0 ? storeName[0].ToString().ToUpper() : "S";
}

<div class="vt-body-no-sidebar">

    @* Profile header *@
    <div style="background:linear-gradient(135deg,#4B3BC7,#26215C);padding:24px;display:flex;align-items:center;gap:20px;margin-bottom:0;">
        <div style="width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,0.2);color:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:500;border:2px solid rgba(255,255,255,0.4);">
            @storeInitial
        </div>
        <div>
            <div style="font-size:20px;font-weight:500;color:#fff;margin-bottom:3px;">@storeName</div>
            <div style="font-size:12px;color:#AFA9EC;display:flex;gap:12px;flex-wrap:wrap;">
                <span><i class="ti ti-building" aria-hidden="true"></i> @((string)(profile?.universityShortName ?? ""))</span>
                <span><i class="ti ti-map-pin" aria-hidden="true"></i> @((string)(profile?.suburb ?? ""))</span>
                @if (!string.IsNullOrEmpty((string)(profile?.residenceName ?? "")))
                {
                    <span><i class="ti ti-home" aria-hidden="true"></i> @((string)(profile?.residenceName ?? ""))</span>
                }
            </div>
            <div style="color:#BA7517;font-size:13px;margin-top:4px;">
                @for (int i = 1; i <= 5; i++) { <span>@(i <= Math.Round(avgRating) ? "★" : "☆")</span> }
                <span style="font-size:11px;color:#AFA9EC;margin-left:4px;">@avgRating.ToString("F1") · @reviews.Count review@(reviews.Count!=1?"s":"")</span>
            </div>
        </div>
        <div style="margin-left:auto;display:flex;gap:8px;">
            <a href="#" style="background:rgba(255,255,255,0.15);color:#fff;border:none;border-radius:7px;padding:8px 16px;font-size:12px;display:flex;align-items:center;gap:5px;text-decoration:none;">
                <i class="ti ti-message-circle" aria-hidden="true"></i> Message
            </a>
        </div>
    </div>

    @* Stats bar *@
    <div style="background:#26215C;padding:12px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:0;">
        @foreach (var (icon, val, lbl) in new[] {
            ("ti-list",           (string)((int)(profile?.totalListings ?? 0)).ToString(), "Listings"),
            ("ti-check",          (string)((int)(profile?.totalSales ?? 0)).ToString(),    "Completed sales"),
            ("ti-star",           avgRating.ToString("F1"),                                "Avg rating"),
            ("ti-clock",          "~1h",                                                    "Response time"),
        })
        {
            <div style="text-align:center;padding:4px;">
                <div style="font-size:16px;font-weight:500;color:#fff;">@val</div>
                <div style="font-size:10px;color:#AFA9EC;">@lbl</div>
            </div>
        }
    </div>

    <div style="padding:20px 24px;display:grid;grid-template-columns:1fr 280px;gap:16px;align-items:start;">

        @* Left — tabs *@
        <div>
            <div style="display:flex;gap:0;border-bottom:0.5px solid #e0ddf5;margin-bottom:14px;">
                @foreach (var tab in new[] { "Listings", "Reviews" })
                {
                    <div style="padding:8px 16px;font-size:12px;cursor:pointer;@(tab=="Listings"?"color:#4B3BC7;border-bottom:2px solid #4B3BC7;font-weight:500;":"color:#888;border-bottom:2px solid transparent;")">@tab</div>
                }
            </div>

            @* Reviews *@
            @if (reviews.Any())
            {
                <div style="display:flex;flex-direction:column;gap:10px;">
                    @foreach (var review in reviews.Take(5))
                    {
                        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px 16px;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                                <div style="width:32px;height:32px;border-radius:50%;background:#4B3BC7;color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;flex-shrink:0;">B</div>
                                <div style="flex:1;">
                                    <div style="font-size:12px;font-weight:500;color:#26215C;">Buyer</div>
                                    <div style="font-size:10px;color:#888;">@review.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                                <div style="color:#BA7517;font-size:12px;">
                                    @for (int i = 1; i <= 5; i++) { <span>@(i <= review.Rating ? "★" : "☆")</span> }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <div style="font-size:12px;color:#555;line-height:1.5;">@review.Comment</div>
                            }
                            <div style="font-size:10px;color:#888;margin-top:6px;">Re: @review.ListingTitle</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;text-align:center;padding:40px;">
                    <i class="ti ti-star" aria-hidden="true" style="font-size:32px;color:#AFA9EC;display:block;margin-bottom:10px;"></i>
                    <div style="font-size:13px;color:#888;">No reviews yet for this seller.</div>
                </div>
            }
        </div>

        @* Right sidebar *@
        <div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;margin-bottom:12px;">
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;">Location & pickup</div>
                @foreach (var (icon, lbl, val) in new[] {
                    ("ti-map-pin", "Suburb",   (string)(profile?.suburb ?? "—")),
                    ("ti-home",    "Residence",(string)(profile?.residenceName ?? "—")),
                    ("ti-building","Campus",   (string)(profile?.universityName ?? "—")),
                })
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:0.5px solid #f0eefb;font-size:12px;">
                        <span style="color:#888;display:flex;align-items:center;gap:5px;"><i class="ti @icon" aria-hidden="true"></i> @lbl</span>
                        <span style="font-weight:500;color:#26215C;">@val</span>
                    </div>
                }
                <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
                    @if ((bool)(profile?.campusPickup ?? false))
                    {
                        <span style="background:#EAF3DE;color:#27500A;font-size:10px;border-radius:5px;padding:3px 8px;display:flex;align-items:center;gap:3px;">
                            <i class="ti ti-check" aria-hidden="true"></i> Campus pickup
                        </span>
                    }
                    @if ((bool)(profile?.deliveryAvailable ?? false))
                    {
                        <span style="background:#EBF5FF;color:#1E6FBF;font-size:10px;border-radius:5px;padding:3px 8px;display:flex;align-items:center;gap:3px;">
                            <i class="ti ti-truck" aria-hidden="true"></i> Delivery available
                        </span>
                    }
                    @if ((bool)(profile?.openToTrades ?? false))
                    {
                        <span style="background:#EEEDFE;color:#4B3BC7;font-size:10px;border-radius:5px;padding:3px 8px;display:flex;align-items:center;gap:3px;">
                            <i class="ti ti-arrows-exchange" aria-hidden="true"></i> Open to trades
                        </span>
                    }
                </div>
            </div>

            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px;">
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;">
                    <i class="ti ti-shield-check" aria-hidden="true" style="color:#27500A;"></i> Safety tips
                </div>
                @foreach (var tip in new[] {
                    "Always meet on campus in a public place",
                    "Inspect items thoroughly before paying",
                    "Never pay upfront without seeing the item",
                    "Report suspicious behaviour to admins",
                })
                {
                    <div style="font-size:11px;color:#555;display:flex;align-items:flex-start;gap:5px;margin-bottom:5px;line-height:1.4;">
                        <i class="ti ti-check" aria-hidden="true" style="color:#4B3BC7;font-size:11px;flex-shrink:0;margin-top:2px;"></i> @tip
                    </div>
                }
            </div>
        </div>
    </div>
</div>