@model VarsityTrade.Web.Models.Listings.ListingDetailViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";

    var relatedListings =
        ViewBag.RelatedListings
        as List<VarsityTrade.Web.Models.Listings.ListingCardViewModel>
        ?? new List<VarsityTrade.Web.Models.Listings.ListingCardViewModel>();

    var isOwner = ViewBag.IsOwner == true;

    var isLoggedIn =
        Context.Session.GetString("AccessToken") != null;

    var storeName =
        string.IsNullOrWhiteSpace(Model.StoreName)
            ? "Seller"
            : Model.StoreName;

    var sellerInitial =
        storeName.Substring(0, 1).ToUpper();
}

@section Styles
{
    <style>
        .vt-detail-main {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 300px;
            gap: 16px;
            align-items: start;
        }

        .vt-product-horizontal {
            display: grid;
            grid-template-columns: minmax(280px, 46%) minmax(0, 1fr);
            gap: 24px;
            align-items: start;
        }

        .vt-product-image {
            width: 100%;
            height: 360px;
            background: var(--vt-primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 8px;
        }

            .vt-product-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .vt-product-image-placeholder {
            font-size: 64px;
            color: var(--vt-primary-muted);
        }

        .vt-product-summary h1 {
            font-size: 22px;
            font-weight: 500;
            margin: 0 0 8px;
            line-height: 1.35;
        }

        .vt-product-price {
            font-size: 25px;
            font-weight: 500;
            color: var(--vt-primary);
            margin-bottom: 12px;
        }

        .vt-product-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 14px;
        }

        .vt-product-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            font-size: 12px;
        }

        .vt-related-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
        }

        .vt-related-card {
            display: block;
            color: inherit;
            text-decoration: none;
            border: 1px solid var(--vt-border);
            border-radius: 8px;
            overflow: hidden;
            background: var(--vt-card);
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .vt-related-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0,0,0,.08);
            }

        .vt-related-image {
            height: 150px;
            background: var(--vt-primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .vt-related-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .vt-related-content {
            padding: 10px;
        }

        .vt-related-title {
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .vt-related-price {
            font-size: 14px;
            font-weight: 500;
            color: var(--vt-primary);
        }

        .vt-related-seller {
            font-size: 11px;
            color: var(--vt-text-muted);
            margin-top: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @@media (max-width: 1000px) {
            .vt-detail-main {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 800px) {
            .vt-product-horizontal {
                grid-template-columns: 1fr;
            }

            .vt-product-image {
                height: 320px;
            }

            .vt-related-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 500px) {
            .vt-product-image {
                height: 260px;
            }

            .vt-product-info-grid {
                grid-template-columns: 1fr;
            }

            .vt-related-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="vt-body">

    @* Sidebar *@
    @await Html.PartialAsync("_Sidebar")

    <div>

        @* Breadcrumb *@
        <div style="font-size:12px;color:var(--vt-text-muted);margin-bottom:14px;">
            <a href="/listings/browse"
               style="color:var(--vt-primary);">
                Browse
            </a>

            <span style="margin:0 6px;">›</span>

            <a href="/listings/browse?category=@Uri.EscapeDataString(Model.CategoryName)"
               style="color:var(--vt-primary);">
                @Model.CategoryName
            </a>

            <span style="margin:0 6px;">›</span>

            <span>@Model.Title</span>
        </div>

        <div class="vt-detail-main">

            @* =========================================================
               LEFT COLUMN
               ========================================================= *@
            <div>

                <div class="vt-card"
                     style="padding:18px;margin-bottom:14px;">

                    <div class="vt-product-horizontal">

                        @* Product image *@
                        <div class="vt-product-image">

                            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                            {
                                <img src="@Model.CoverImageUrl"
                                     alt="@Model.Title" />
                            }
                            else
                            {
                                <div class="vt-product-image-placeholder">
                                    <i class="ti ti-photo"
                                       aria-hidden="true"></i>
                                </div>
                            }

                        </div>

                        @* Product summary *@
                        <div class="vt-product-summary">

                            @if (Model.IsFeatured)
                            {
                                <span class="vt-badge vt-badge-primary"
                                      style="margin-bottom:8px;">
                                    <i class="ti ti-star"
                                       aria-hidden="true"></i>
                                    Featured
                                </span>
                            }

                            <h1>@Model.Title</h1>

                            <div class="vt-product-price">
                                R @Model.Price.ToString("N0")

                                @if (Model.IsNegotiable)
                                {
                                    <span style="
                                        font-size:12px;
                                        font-weight:400;
                                        color:var(--vt-text-muted);
                                        margin-left:6px;">
                                        Negotiable
                                    </span>
                                }
                            </div>

                            <div class="vt-product-meta">

                                <span class="vt-badge vt-badge-muted">
                                    @Model.Condition
                                </span>

                                <span class="vt-badge vt-badge-primary">
                                    @Model.ListingType
                                </span>

                                @if (Model.Quantity > 1)
                                {
                                    <span class="vt-badge vt-badge-muted">
                                        @Model.Quantity available
                                    </span>
                                }

                            </div>

                            <div class="vt-divider"></div>

                            <div class="vt-product-info-grid">

                                <div>
                                    <span style="color:var(--vt-text-muted);">
                                        Category
                                    </span>

                                    <div style="font-weight:500;margin-top:2px;">
                                        @Model.CategoryName
                                    </div>
                                </div>

                                <div>
                                    <span style="color:var(--vt-text-muted);">
                                        Condition
                                    </span>

                                    <div style="font-weight:500;margin-top:2px;">
                                        @Model.Condition
                                    </div>
                                </div>

                                <div>
                                    <span style="color:var(--vt-text-muted);">
                                        Campus pickup
                                    </span>

                                    <div style="font-weight:500;margin-top:2px;">
                                        @(Model.CampusPickup
                                            ? "Available"
                                            : "Not available")
                                    </div>
                                </div>

                                <div>
                                    <span style="color:var(--vt-text-muted);">
                                        Delivery
                                    </span>

                                    <div style="font-weight:500;margin-top:2px;">
                                        @(Model.DeliveryAvailable
                                            ? "Available"
                                            : "Not available")
                                    </div>
                                </div>

                                <div>
                                    <span style="color:var(--vt-text-muted);">
                                        Views
                                    </span>

                                    <div style="font-weight:500;margin-top:2px;">
                                        @Model.ViewCount
                                    </div>
                                </div>

                                <div>
                                    <span style="color:var(--vt-text-muted);">
                                        Listed
                                    </span>

                                    <div style="font-weight:500;margin-top:2px;">
                                        @Model.CreatedAt.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                @* =====================================================
                   YOU MAY ALSO LIKE
                   ===================================================== *@
                @if (relatedListings.Any())
                {
                    <div class="vt-card" style="margin-bottom:14px;">

                        <div class="vt-card-title">
                            <i class="ti ti-sparkles"
                               aria-hidden="true"></i>
                            You may also like
                        </div>

                        <div class="vt-related-grid">

                            @foreach (var related in relatedListings)
                            {
                                <a href="/listings/@related.ListingId"
                                   class="vt-related-card">

                                    <div class="vt-related-image">

                                        @if (!string.IsNullOrWhiteSpace(
                                            related.CoverImageUrl))
                                        {
                                            <img src="@related.CoverImageUrl"
                                                 alt="@related.Title" />
                                        }
                                        else
                                        {
                                            <i class="ti ti-photo"
                                               style="
                                            font-size:38px;
                                            color:var(--vt-primary-muted);"
                                               aria-hidden="true"></i>
                                        }

                                    </div>

                                    <div class="vt-related-content">

                                        <div class="vt-related-title">
                                            @related.Title
                                        </div>

                                        <div class="vt-related-price">
                                            R @related.Price.ToString("N0")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            related.StoreName))
                                        {
                                            <div class="vt-related-seller">
                                                @related.StoreName
                                            </div>
                                        }

                                    </div>

                                </a>
                            }

                        </div>

                    </div>
                }

                @* =====================================================
                   DESCRIPTION
                   ===================================================== *@
                <div class="vt-card">

                    <div class="vt-card-title">
                        <i class="ti ti-file-description"
                           aria-hidden="true"></i>
                        Description
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p style="
                            font-size:13px;
                            color:var(--vt-text-secondary);
                            line-height:1.7;
                            margin:0;">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p style="
                            font-size:13px;
                            color:var(--vt-text-muted);
                            margin:0;">
                            No description provided by the seller.
                        </p>
                    }

                </div>

            </div>

            @* =========================================================
               RIGHT COLUMN
               ========================================================= *@
            <div>

                @* Seller card *@
                <div class="vt-card" style="margin-bottom:12px;">

                    <div class="vt-card-title">
                        <i class="ti ti-store"
                           aria-hidden="true"></i>
                        Seller
                    </div>

                    <div style="
                        display:flex;
                        align-items:center;
                        gap:10px;
                        margin-bottom:12px;">

                        <div style="
                            width:44px;
                            height:44px;
                            border-radius:50%;
                            background:var(--vt-primary);
                            color:#fff;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            font-size:16px;
                            font-weight:500;
                            flex-shrink:0;">
                            @sellerInitial
                        </div>

                        <div>

                            <div style="
                                font-size:13px;
                                font-weight:500;">
                                @storeName
                            </div>

                            <div style="
                                font-size:11px;
                                color:var(--vt-text-muted);">

                                <i class="ti ti-building"
                                   aria-hidden="true"></i>

                                @Model.UniversityShortName
                            </div>

                            <div style="
                                font-size:11px;
                                color:var(--vt-star);">

                                ★ @Model.SellerRating.ToString("F1")
                            </div>

                        </div>

                    </div>

                    @* =================================================
                       OWNER MANAGEMENT
                       Only the actual owner in Seller Mode sees this.
                       ================================================= *@
                    @if (isOwner)
                    {
                        <div style="
                            background:#EEEDFE;
                            border:0.5px solid #AFA9EC;
                            border-radius:8px;
                            padding:10px;
                            margin-bottom:10px;">

                            <div style="
                                font-size:12px;
                                font-weight:500;
                                color:var(--vt-primary);
                                margin-bottom:8px;">

                                <i class="ti ti-settings"
                                   aria-hidden="true"></i>
                                Manage your listing
                            </div>

                            <a href="/seller/listings/edit/@Model.ListingId"
                               class="vt-btn vt-btn-outline"
                               style="
                                width:100%;
                                justify-content:center;
                                margin-bottom:8px;">

                                <i class="ti ti-edit"
                                   aria-hidden="true"></i>
                                Edit listing
                            </a>

                            <form asp-controller="Seller"
                                  asp-action="DeleteListing"
                                  method="post"
                                  style="margin:0;">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="listingId"
                                       value="@Model.ListingId" />

                                <button type="submit"
                                        class="vt-btn"
                                        style="
                                    width:100%;
                                    justify-content:center;
                                    color:#c0392b;
                                    border:1px solid #e6b0aa;
                                    background:#fff;"
                                        onclick="return confirm('Delete this listing?');">

                                    <i class="ti ti-trash"
                                       aria-hidden="true"></i>
                                    Delete listing
                                </button>

                            </form>

                        </div>
                    }

                    @* =================================================
                       BUYER / GUEST ACTIONS
                       Owners do not see buyer actions.
                       ================================================= *@
                    @if (!isOwner)
                    {
                        @if (isLoggedIn)
                        {
                            <a href="/buyer/inbox?listingId=@Model.ListingId"
                               class="vt-btn vt-btn-outline"
                               style="
                                width:100%;
                                justify-content:center;
                                margin-bottom:8px;">

                                <i class="ti ti-message-circle"
                                   aria-hidden="true"></i>
                                Message seller
                            </a>

                            <a href="/buyer/offers/make?listingId=@Model.ListingId"
                               class="vt-btn vt-btn-primary"
                               style="
                                width:100%;
                                justify-content:center;">

                                <i class="ti ti-arrows-exchange"
                                   aria-hidden="true"></i>
                                Make an offer
                            </a>
                        }
                        else
                        {
                            <a href="/auth/login"
                               class="vt-btn vt-btn-primary"
                               style="
                                width:100%;
                                justify-content:center;">

                                <i class="ti ti-login"
                                   aria-hidden="true"></i>
                                Log in to contact seller
                            </a>
                        }
                    }

                </div>

                @* Safety tips *@
                <div class="vt-card"
                     style="
                    background:var(--vt-primary-light);
                    border-color:var(--vt-primary-muted);">

                    <div class="vt-card-title"
                         style="
                        color:var(--vt-primary);
                        border-color:var(--vt-primary-muted);">

                        <i class="ti ti-shield-check"
                           aria-hidden="true"></i>
                        Safety tips

                    </div>

                    <ul style="
                        font-size:12px;
                        color:var(--vt-primary);
                        padding-left:16px;
                        line-height:1.8;
                        margin-bottom:0;">

                        <li>
                            Always meet on campus in a public area
                        </li>

                        <li>
                            Inspect the item before paying
                        </li>

                        <li>
                            Never pay upfront via EFT
                        </li>

                        <li>
                            Report suspicious listings to admin
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>