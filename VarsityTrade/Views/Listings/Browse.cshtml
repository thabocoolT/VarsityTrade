@model VarsityTrade.Web.Models.Listings.BrowseViewModel

@{
    ViewData["Title"] = "Browse Listings";
    Layout = "_Layout";

    var isLoggedIn =
        Context.Session.GetString("AccessToken") != null;
}

<div style="padding:0 24px;">

    @* University / guest banner *@
    <div style="background:#EEEDFE;
                border:0.5px solid #AFA9EC;
                border-radius:10px;
                padding:10px 14px;
                display:flex;
                align-items:center;
                gap:10px;
                margin:12px 0;">

        <i class="ti ti-building"
           aria-hidden="true"
           style="font-size:18px;color:#4B3BC7;"></i>

        <div style="font-size:12px;color:#3C3489;">

            @if (isLoggedIn)
            {
                <span>
                    Showing listings from
                    <b>@Model.UniversityName</b>
                    only.
                </span>
            }
            else
            {
                <span>
                    Browse student listings across South African
                    universities.
                    <a href="/auth/register"
                       style="color:#4B3BC7;font-weight:500;">
                        Register free
                    </a>
                    to use campus-locked browsing.
                </span>
            }

        </div>
    </div>

    <div style="display:grid;
                grid-template-columns:220px 1fr;
                gap:16px;
                align-items:start;
                padding-bottom:24px;">

        @* =========================================================
           FILTER SIDEBAR
           ========================================================= *@

        <form method="get"
              action="/listings/browse"
              style="background:#fff;
                     border:0.5px solid #e0ddf5;
                     border-radius:12px;
                     padding:16px;
                     display:flex;
                     flex-direction:column;
                     gap:16px;
                     position:sticky;
                     top:86px;">

            @* Preserve search *@
            <input type="hidden"
                   name="q"
                   value="@Model.SearchQuery" />

            @* Category filter with subcategories *@
            <div>
                <div style="font-size:12px;font-weight:500;color:#26215C;margin-bottom:10px;padding-bottom:6px;border-bottom:0.5px solid #e0ddf5;">
                    <i class="ti ti-category" aria-hidden="true"></i> Category
                </div>
                <div style="display:flex;flex-direction:column;gap:2px;">
                    @{
                        var allCats = ViewBag.Categories as List<dynamic> ?? new List<dynamic>();
                        var parentCats = new[] {
                ("ti-layout-grid", "All listings",          "",                       new string[]{}),
                ("ti-device-laptop","Electronics",          "Electronics",            new[]{"Laptops","Phones & Tablets","Cameras","Gaming","Audio","Other Electronics"}),
                ("ti-book",        "Study materials",       "Study Materials",        new[]{"Textbooks","Notes & Summaries","Study Guides","Stationery"}),
                ("ti-sofa",        "Furniture",             "Furniture",              new[]{"Beds & Bedding","Desks & Chairs","Wardrobes","Other Furniture"}),
                ("ti-hanger",      "Clothing",              "Clothing & Accessories", new[]{"Men's Clothing","Women's Clothing","Shoes","Accessories"}),
                ("ti-tool-kitchen-2","Household",           "Household & Kitchen",    new[]{"Kitchen Appliances","Cleaning","Decor","Other"}),
                ("ti-bike",        "Sports & fitness",      "Sports & Fitness",       new[]{"Gym Equipment","Sports Gear","Outdoor","Cycling"}),
                ("ti-briefcase",   "Services",              "Services",               new[]{"Tutoring","Printing","Delivery","Other Services"}),
                ("ti-dots",        "Other",                 "Other",                  new string[]{}),
            };
                    }
                    @foreach (var (icon, label, val, subs) in parentCats)
                    {
                        var isActive = (string.IsNullOrEmpty(val) && string.IsNullOrEmpty(Model.SelectedCategory))
                                       || val == Model.SelectedCategory
                                       || (subs.Length > 0 && subs.Contains(Model.SelectedCategory ?? ""));
                        var hasActiveSub = subs.Any(s => s == Model.SelectedCategory);

                        <div>
                            @* Parent category row *@
                            <a href="/listings/browse?q=@Model.SearchQuery&category=@val&condition=@Model.SelectedCondition"
                               style="display:flex;align-items:center;justify-content:space-between;padding:6px 8px;border-radius:6px;font-size:12px;text-decoration:none;@(isActive ? "background:#EEEDFE;color:#4B3BC7;font-weight:500;" : "color:#444;")">
                                <span style="display:flex;align-items:center;gap:6px;">
                                    <i class="ti @icon" aria-hidden="true" style="font-size:13px;"></i> @label
                                </span>
                                @if (subs.Length > 0)
                                {
                                    <i class="ti ti-chevron-@(isActive ? "down" : "right")" aria-hidden="true" style="font-size:11px;color:#aaa;"></i>
                                }
                            </a>

                            @* Subcategories — shown when parent is active *@
                            @if (subs.Length > 0 && isActive)
                            {
                                <div style="margin-left:16px;margin-top:2px;display:flex;flex-direction:column;gap:2px;">
                                    @foreach (var sub in subs)
                                    {
                                        var isSubActive = Model.SelectedCategory == sub;
                                        <a href="/listings/browse?q=@Model.SearchQuery&category=@sub&condition=@Model.SelectedCondition"
                                           style="display:flex;align-items:center;gap:6px;padding:4px 8px;border-radius:5px;font-size:11px;text-decoration:none;@(isSubActive ? "background:#EEEDFE;color:#4B3BC7;font-weight:500;" : "color:#666;")">
                                            <i class="ti ti-point" aria-hidden="true" style="font-size:10px;"></i> @sub
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* CONDITION *@
            <div>

                <div style="font-size:12px;
                            font-weight:500;
                            color:#26215C;
                            margin-bottom:10px;
                            padding-bottom:6px;
                            border-bottom:0.5px solid #e0ddf5;">

                    <i class="ti ti-tag"
                       aria-hidden="true"></i>

                    Condition

                </div>

                <select name="condition"
                        style="width:100%;
                               border:0.5px solid #ddd;
                               border-radius:7px;
                               padding:8px 9px;
                               font-size:12px;
                               color:#444;
                               background:#fff;
                               cursor:pointer;">

                    <option value="">
                        All conditions
                    </option>

                    @foreach (var condition in new[]
                    {
                        "New",
                        "Like New",
                        "Good",
                        "Fair"
                    })
                    {
                        if (string.Equals(
                            Model.SelectedCondition,
                            condition,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@condition" selected>
                                @condition
                            </option>
                        }
                        else
                        {
                            <option value="@condition">
                                @condition
                            </option>
                        }
                    }

                </select>

            </div>

            @* PRICE *@
            <div>

                <div style="font-size:12px;
                            font-weight:500;
                            color:#26215C;
                            margin-bottom:10px;
                            padding-bottom:6px;
                            border-bottom:0.5px solid #e0ddf5;">

                    <i class="ti ti-currency-rand"
                       aria-hidden="true"></i>

                    Price range

                </div>

                <div style="display:flex;gap:6px;">

                    <input type="number"
                           name="minPrice"
                           value="@Model.MinPrice"
                           placeholder="Min"
                           min="0"
                           step="0.01"
                           style="width:50%;
                                  border:0.5px solid #ddd;
                                  border-radius:6px;
                                  padding:7px 8px;
                                  font-size:11px;" />

                    <input type="number"
                           name="maxPrice"
                           value="@Model.MaxPrice"
                           placeholder="Max"
                           min="0"
                           step="0.01"
                           style="width:50%;
                                  border:0.5px solid #ddd;
                                  border-radius:6px;
                                  padding:7px 8px;
                                  font-size:11px;" />

                </div>

            </div>

            @* SELLER RATING *@
            <div>

                <div style="font-size:12px;
                            font-weight:500;
                            color:#26215C;
                            margin-bottom:10px;
                            padding-bottom:6px;
                            border-bottom:0.5px solid #e0ddf5;">

                    <i class="ti ti-star"
                       aria-hidden="true"></i>

                    Seller rating

                </div>

                <select name="minRating"
                        style="width:100%;
                               border:0.5px solid #ddd;
                               border-radius:7px;
                               padding:8px 9px;
                               font-size:12px;
                               color:#444;
                               background:#fff;">

                    <option value="">
                        Any rating
                    </option>

                    <option value="5"
                            selected="@(Model.SelectedMinRating == 5)">
                        5 stars
                    </option>

                    <option value="4"
                            selected="@(Model.SelectedMinRating == 4)">
                        4+ stars
                    </option>

                    <option value="3"
                            selected="@(Model.SelectedMinRating == 3)">
                        3+ stars
                    </option>

                </select>

            </div>

            @* SORT *@
            <div>

                <div style="font-size:12px;
                            font-weight:500;
                            color:#26215C;
                            margin-bottom:10px;
                            padding-bottom:6px;
                            border-bottom:0.5px solid #e0ddf5;">

                    <i class="ti ti-arrows-sort"
                       aria-hidden="true"></i>

                    Sort

                </div>

                <select name="sort"
                        style="width:100%;
                               border:0.5px solid #ddd;
                               border-radius:7px;
                               padding:8px 9px;
                               font-size:12px;
                               color:#444;
                               background:#fff;">

                    <option value="">
                        Newest first
                    </option>

                    <option value="price-low"
                            selected="@(Model.SelectedSort == "price-low")">
                        Price: Low to high
                    </option>

                    <option value="price-high"
                            selected="@(Model.SelectedSort == "price-high")">
                        Price: High to low
                    </option>

                    <option value="rating"
                            selected="@(Model.SelectedSort == "rating")">
                        Top rated sellers
                    </option>

                </select>

            </div>

            @* APPLY *@
            <button type="submit"
                    style="background:#4B3BC7;
                           color:#fff;
                           border:none;
                           border-radius:6px;
                           padding:8px;
                           font-size:12px;
                           font-weight:500;
                           cursor:pointer;">

                Apply filters

            </button>

            @* CLEAR *@
            <a href="/listings/browse"
               style="background:#fff;
                      color:#888;
                      border:0.5px solid #ddd;
                      border-radius:6px;
                      padding:7px;
                      font-size:12px;
                      text-align:center;
                      text-decoration:none;">

                Clear all filters

            </a>

        </form>

        @* =========================================================
           RESULTS
           ========================================================= *@

        <div>

            <div style="background:#fff;
                        border:0.5px solid #e0ddf5;
                        border-radius:10px;
                        padding:10px 14px;
                        display:flex;
                        align-items:center;
                        justify-content:space-between;
                        margin-bottom:12px;">

                <div style="font-size:12px;color:#666;">

                    <b style="color:#26215C;font-weight:500;">
                        @Model.TotalCount listings
                    </b>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <span>
                            for "@Model.SearchQuery"
                        </span>
                    }
                    else
                    {
                        <span>
                            available
                        </span>
                    }

                </div>

            </div>

            @if (Model.Listings.Any())
            {
                <div style="display:grid;
                            grid-template-columns:repeat(3,minmax(0,1fr));
                            gap:10px;">

                    @foreach (var listing in Model.Listings)
                    {
                        <div style="background:#fff;
            border:0.5px solid #e0ddf5;
            border-radius:10px;
            overflow:hidden;
            position:relative;">

    <div style="background:#f0eefb;
                height:140px;
                display:flex;
                align-items:center;
                justify-content:center;
                color:#7F77DD;
                font-size:32px;
                position:relative;">

        <a href="/listings/@listing.ListingId"
           style="display:block;
                  width:100%;
                  height:100%;
                  text-decoration:none;
                  color:inherit;">

            @if (!string.IsNullOrEmpty(listing.CoverImageUrl))
            {
                <img src="@ImageHelper.ResolveUrl(listing.CoverImageUrl)"
                     alt="@listing.Title"
                     style="width:100%;
                            height:100%;
                            object-fit:cover;" />
            }
            else
            {
                <div style="width:100%;
                            height:100%;
                            display:flex;
                            align-items:center;
                            justify-content:center;">
                    <i class="ti ti-photo"
                       aria-hidden="true"></i>
                </div>
            }

        </a>

        @if (listing.IsFeatured)
        {
            <span style="position:absolute;
                         top:6px;
                         left:6px;
                         background:#4B3BC7;
                         color:#fff;
                         font-size:9px;
                         padding:2px 6px;
                         border-radius:4px;
                         z-index:2;">
                Featured
            </span>
        }

        @if (isLoggedIn)
        {
            <form method="post"
                  action="/buyer/saved/save"
                  style="position:absolute;
                         top:6px;
                         right:6px;
                         margin:0;
                         z-index:3;">

                <input type="hidden"
                       name="listingId"
                       value="@listing.ListingId" />

                <input type="hidden"
                       name="returnUrl"
                       value="@Context.Request.Path@Context.Request.QueryString" />

                <button type="submit"
                        title="@(listing.IsSaved ? "Already saved" : "Save listing")"
                        aria-label="@(listing.IsSaved ? "Already saved" : "Save listing")"
                        style="width:30px;
                               height:30px;
                               border:none;
                               border-radius:50%;
                               background:rgba(255,255,255,.95);
                               color:@(listing.IsSaved ? "#e74c3c" : "#777");
                               display:flex;
                               align-items:center;
                               justify-content:center;
                               cursor:pointer;
                               box-shadow:0 1px 4px rgba(0,0,0,.12);">

                    <i class="ti @(listing.IsSaved ? "ti-heart-filled" : "ti-heart")"
                       aria-hidden="true"
                       style="font-size:16px;"></i>

                </button>

            </form>
        }

    </div>

    <a href="/listings/@listing.ListingId"
       style="display:block;
              padding:8px 10px;
              text-decoration:none;
              color:inherit;">

        <div style="font-size:12px;
                    font-weight:500;
                    color:#26215C;
                    margin-bottom:2px;
                    white-space:nowrap;
                    overflow:hidden;
                    text-overflow:ellipsis;">
            @listing.Title
        </div>

        <div style="font-size:13px;
                    font-weight:500;
                    color:#4B3BC7;
                    margin-bottom:3px;">
            R @listing.Price.ToString("N0")
        </div>

        <div style="font-size:10px;
                    color:#888;
                    display:flex;
                    align-items:center;
                    gap:4px;
                    flex-wrap:wrap;">

            <span>@listing.Condition</span>
            <span>·</span>
            <span>@listing.CategoryName</span>
            <span>·</span>
            <span>★ @listing.SellerRating.ToString("F1")</span>

        </div>

    </a>

</div>
                    }

                </div>
            }
            else
            {
                <div style="background:#fff;
                            border:0.5px solid #e0ddf5;
                            border-radius:12px;
                            text-align:center;
                            padding:60px 20px;">

                    <i class="ti ti-search"
                       aria-hidden="true"
                       style="font-size:40px;
                              color:#AFA9EC;
                              display:block;
                              margin-bottom:12px;"></i>

                    <div style="font-size:14px;
                                font-weight:500;
                                margin-bottom:6px;">
                        No listings found
                    </div>

                    <p style="font-size:12px;color:#888;">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                        {
                            <span>
                                No listings match
                                "@Model.SearchQuery".
                            </span>
                        }
                        else
                        {
                            <span>
                                No listings match the selected filters.
                            </span>
                        }
                    </p>

                    <a href="/listings/browse"
                       style="display:inline-block;
                              margin-top:10px;
                              color:#4B3BC7;
                              font-size:12px;
                              text-decoration:none;">
                        Clear filters
                    </a>

                </div>
            }

        </div>

    </div>

</div>