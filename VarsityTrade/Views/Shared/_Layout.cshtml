@inject VarsityTrade.Web.Services.ApiService ApiService

<script>
    document.addEventListener("DOMContentLoaded", function() {

        const trigger =
            document.getElementById("vt-category-trigger");

        const menu =
            document.getElementById("vt-category-menu");

        const chevron =
            document.getElementById("vt-category-chevron");

        if (!trigger || !menu) {
            return;
        }

        function setMenuState(open) {

            menu.style.display =
                open ? "block" : "none";

            trigger.setAttribute(
                "aria-expanded",
                open ? "true" : "false"
            );

            if (chevron) {
                chevron.className =
                    open
                        ? "ti ti-chevron-up"
                        : "ti ti-chevron-down";
            }
        }

        trigger.addEventListener("click", function(event) {

            event.stopPropagation();

            const isOpen =
                menu.style.display === "block";

            setMenuState(!isOpen);
        });

        trigger.addEventListener("keydown", function(event) {

            if (event.key === "Enter" ||
                event.key === " ") {

                event.preventDefault();

                const isOpen =
                    menu.style.display === "block";

                setMenuState(!isOpen);
            }
        });

        document.addEventListener("click", function(event) {

            if (!trigger.contains(event.target)) {
                setMenuState(false);
            }
        });
    });
</script>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Varsity Trade</title>

    <!--  Tabler Icons — icon library used throughout the platform -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />

    <!-- Varsity Trade brand stylesheet -->
    <link rel="stylesheet" href="~/css/varsitytrade.css" asp-append-version="true" />

    <!-- Page-specific styles injected here -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ── ANNOUNCEMENT BAR ─────────────────────────────────── -->
    <div class="vt-announce">
        <i class="ti ti-speakerphone" aria-hidden="true"></i>
        Welcome to Varsity Trade — The #1 Marketplace for Students
    </div>

    <!-- ── NAVBAR ───────────────────────────────────────────── -->
    <nav class="vt-nav">

        @{
            var navCategories =
                await ApiService.GetAsync<
                    List<VarsityTrade.Web.Models.Seller.CategoryOption>>(
                        "api/categories")
                ?? new List<VarsityTrade.Web.Models.Seller.CategoryOption>();
        }

        <!-- Logo -->
        <a href="/" class="vt-nav-logo">
            <div class="vt-nav-logo-icon">
                <i class="ti ti-school" aria-hidden="true"></i>
            </div>
            <div>
                <div class="vt-nav-logo-text">Varsity Trade</div>
                <div class="vt-nav-logo-sub">Buy. Sell. Trade.</div>
            </div>
        </a>

        <!-- Categories dropdown trigger -->
        <div class="vt-nav-cat"
             id="vt-category-trigger"
             role="button"
             tabindex="0"
             aria-expanded="false"
             aria-haspopup="true"
             style="position:relative;">

            <i class="ti ti-category"
               aria-hidden="true"
               style="font-size:13px"></i>

            All categories

            <i class="ti ti-chevron-down"
               id="vt-category-chevron"
               aria-hidden="true"
               style="font-size:12px"></i>

            <div id="vt-category-menu"
                 style="display:none;
                position:absolute;
                top:calc(100% + 8px);
                left:0;
                min-width:210px;
                max-height:360px;
                overflow-y:auto;
                background:#fff;
                border:0.5px solid #e0ddf5;
                border-radius:10px;
                box-shadow:0 8px 24px rgba(38,33,92,0.12);
                padding:6px;
                z-index:1000;">

                <a href="/listings/browse"
                   style="display:block;
                    padding:8px 10px;
                    border-radius:6px;
                    color:#26215C;
                    text-decoration:none;
                    font-size:12px;">
                    All categories
                </a>

                @foreach (var category in navCategories)
                {
                    var encodedCategory =
                        Uri.EscapeDataString(category.Name);

                    <a href="/listings/browse?category=@encodedCategory"
                       style="display:block;
                        padding:8px 10px;
                        border-radius:6px;
                        color:#444;
                        text-decoration:none;
                        font-size:12px;">
                        @category.Name
                    </a>
                }
            </div>
        </div>

        <!-- Search bar -->
        <form class="vt-nav-search" asp-controller="Listings" asp-action="Search" method="get">
            <input type="text"
                   name="q"
                   placeholder="Search for items, brands or keywords..."
                   value="@ViewData["SearchQuery"]" />
            <button type="submit" class="vt-nav-search-btn">
                <i class="ti ti-search" aria-hidden="true"></i>
            </button>
        </form>

        <!-- Nav links -->
        <div class="vt-nav-links">
            <a href="/listings/browse">Explore</a>
            <a href="/home/how-it-works">How it works</a>
        </div>

        @if (Context.Session.GetString("AccessToken") != null)
        {
            var currentMode = Context.Session.GetString("CurrentMode") ?? "Buyer";
            var hasSellerProfile = Context.Session.GetString("HasSellerProfile") == "true";
            var isSeller = currentMode == "Seller";

            <div class="vt-nav-icons">

                @if (isSeller)
                {
                    @* SELLER MODE navbar icons *@
                    <a href="/buyer/inbox" class="vt-nav-icon-btn" title="Seller Inbox">
                        <i class="ti ti-message-circle" aria-hidden="true"></i>
                    </a>
                    <a href="/buyer/notifications" class="vt-nav-icon-btn" title="Notifications">
                        <i class="ti ti-bell" aria-hidden="true"></i>
                    </a>
                    <a href="/buyer/profile" class="vt-nav-avatar" title="My Account">
                        @(Context.Session.GetString("UserInitials") ?? "?")
                    </a>
                    <a href="/auth/logout" class="vt-nav-icon-btn" title="Log out">
                        <i class="ti ti-logout" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    @* BUYER MODE navbar icons *@
                    <a href="/buyer/inbox" class="vt-nav-icon-btn" title="Inbox">
                        <i class="ti ti-message-circle" aria-hidden="true"></i>
                    </a>
                    <a href="/buyer/notifications" class="vt-nav-icon-btn" title="Notifications">
                        <i class="ti ti-bell" aria-hidden="true"></i>
                    </a>
                    <a href="/buyer/profile" class="vt-nav-avatar" title="My Profile">
                        @(Context.Session.GetString("UserInitials") ?? "?")
                    </a>
                    <a href="/auth/logout" class="vt-nav-icon-btn" title="Log out">
                        <i class="ti ti-logout" aria-hidden="true"></i>
                    </a>
                }

            </div>

            @* Mode switch button and action button *@
            @if (isSeller)
            {
                @* In seller mode — show Switch to Buyer and New Listing *@
                <a href="/seller/switch-to-buyer" class="vt-btn vt-btn-outline" style="font-size:11px;padding:7px 12px;">
                    <i class="ti ti-shopping-cart" aria-hidden="true"></i> Switch to buyer
                </a>
                @if (isSeller)
                {
                    <a href="/seller/listings/create" class="vt-sell-btn">
                        <i class="ti ti-plus" aria-hidden="true"></i> New listing
                    </a>
                }
                else
                {
                    <a href="/listings/browse" class="vt-sell-btn">
                        <i class="ti ti-search" aria-hidden="true"></i> Browse
                    </a>
                }
            }
            else
            {
                @* In buyer mode — show Switch to Seller only if they have a seller profile *@
                @if (hasSellerProfile)
                {
                    <a href="/seller/switch-to-seller" class="vt-btn vt-btn-outline" style="font-size:11px;padding:7px 12px;">
                        <i class="ti ti-store" aria-hidden="true"></i> My Shop
                    </a>
                }
                else
                {
                    <a href="/seller/activate" class="vt-btn vt-btn-outline" style="font-size:11px;padding:7px 12px;">
                        <i class="ti ti-store" aria-hidden="true"></i> Start selling
                    </a>
                }
                <a href="/listings/browse" class="vt-sell-btn">
                    <i class="ti ti-search" aria-hidden="true"></i> Browse
                </a>
            }
        }
        else
        {
            @* Guest navbar *@
            <div class="vt-nav-links">
                <a href="/auth/login">Log in</a>
            </div>
            <a href="/auth/register" class="vt-sell-btn">
                <i class="ti ti-plus" aria-hidden="true"></i> Sell an item
            </a>
        }

    </nav>

    <!-- ── PAGE CONTENT ─────────────────────────────────────── -->
    <main>
        @RenderBody()
    </main>

    <!-- ── FOOTER ───────────────────────────────────────────── -->
    <footer>
        @* Full 4-column footer matching wireframe *@
        <div style="background:#26215C;padding:24px;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:20px;">
            @* Brand column *@
            <div>
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;">
                    <div style="background:#4B3BC7;color:#fff;border-radius:6px;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:12px;">
                        <i class="ti ti-shopping-bag" aria-hidden="true"></i>
                    </div>
                    <span style="font-size:13px;font-weight:500;color:#fff;">Varsity Trade</span>
                </div>
                <div style="font-size:11px;color:#AFA9EC;line-height:1.5;margin-bottom:10px;">
                    A trusted marketplace built<br>for students, by students.
                </div>
                <div style="display:flex;gap:8px;">
                    @foreach (var icon in new[] { "ti-brand-instagram", "ti-brand-x", "ti-brand-tiktok", "ti-brand-youtube" })
                    {
                        <div style="width:26px;height:26px;border-radius:50%;background:#3C3489;display:flex;align-items:center;justify-content:center;color:#AFA9EC;font-size:13px;">
                            <i class="ti @icon" aria-hidden="true"></i>
                        </div>
                    }
                </div>
            </div>

            @* Marketplace column *@
            <div>
                <div style="font-size:12px;font-weight:500;color:#fff;margin-bottom:10px;">Marketplace</div>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <a href="/listings/browse" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Browse items
                    </a>

                    <a href="/seller/activate" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Sell an item
                    </a>

                    <a href="/listings/browse" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Categories
                    </a>

                    <a href="/home/how-it-works" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        How it works
                    </a>

                    <a href="/home/safety" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Safety tips
                    </a>
                </div>
            </div>

            @* Support column *@
            <div>
                <div style="font-size:12px;font-weight:500;color:#fff;margin-bottom:10px;">Support</div>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <a href="/home/help" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Help centre
                    </a>

                    <a href="/home/contact" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Contact us
                    </a>

                    <a href="/home/report" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Report an issue
                    </a>

                    <a href="/home/terms" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Terms of use
                    </a>

                    <a href="/home/privacy" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Privacy policy
                    </a>
                </div>
            </div>

            @* Company column *@
            <div>
                <div style="font-size:12px;font-weight:500;color:#fff;margin-bottom:10px;">Company</div>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <a href="/home/about" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        About us
                    </a>

                    <a href="/home/blog" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Blog
                    </a>

                    <a href="/home/careers" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Careers
                    </a>

                    <a href="/home/ambassadors" style="font-size:11px;color:#AFA9EC;text-decoration:none;">
                        Student ambassadors
                    </a>
                </div>
            </div>
        </div>

        @* Footer bottom bar *@
        <div style="background:#1a1448;padding:10px 24px;display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:11px;color:#534AB7;">© 2026 Varsity Trade. All rights reserved.</span>
            <div style="display:flex;gap:14px;">
                <a href="/home/terms" style="font-size:11px;color:#534AB7;text-decoration:none;">
                    Terms
                </a>

                <a href="/home/privacy" style="font-size:11px;color:#534AB7;text-decoration:none;">
                    Privacy
                </a>

                <a href="/home/cookies" style="font-size:11px;color:#534AB7;text-decoration:none;">
                    Cookies
                </a>
            </div>
        </div>
    </footer>

    <!-- Page-specific scripts injected here -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>