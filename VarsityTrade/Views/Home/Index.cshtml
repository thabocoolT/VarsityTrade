            <input type="text"
                   placeholder="Enter your student email"
                   style="border:0.5px solid #AFA9EC;
            border-radius:6px;
            padding:8px 12px;
            font-size:12px;
            background:#fff;
            color:#26215C;
            width:220px;
            outline:none;" />

            <button style="background:#4B3BC7;
