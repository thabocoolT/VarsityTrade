@{
    ViewData["Title"] = "Varsity Trade — Student Marketplace";
    Layout = "_Layout";

    var recentListings =
        ViewBag.RecentListings as List<VarsityTrade.Web.Models.Listings.ListingCardViewModel>
        ?? new();

    var featuredListings =
        ViewBag.FeaturedListings as List<VarsityTrade.Web.Models.Listings.ListingCardViewModel>
        ?? new();

    var isLoggedIn =
        Context.Session.GetString("AccessToken") != null;
}

<div style="background:#f5f4f9;">

    @* ── HERO ──────────────────────────────────────────────── *@
    <div style="background:#fff;
        padding:24px;
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:24px;
        align-items:center;">

        <div>
            <div style="font-size:22px;
                font-weight:500;
                color:#26215C;
                line-height:1.3;
                margin-bottom:8px;">
                Everything students need,<br>
                <span style="color:#4B3BC7;">from students.</span>
            </div>

            <div style="font-size:13px;
                color:#666;
                margin-bottom:18px;
                line-height:1.6;">
                Buy, sell or trade almost anything you need for student life.
                Affordable. Local. Trusted.
            </div>

            <div style="display:flex;
                gap:10px;
                margin-bottom:20px;">

                <a href="/listings/browse"
                   style="background:#4B3BC7;
                    color:#fff;
                    border:none;
                    border-radius:6px;
                    padding:9px 18px;
                    font-size:12px;
                    font-weight:500;
                    display:flex;
                    align-items:center;
                    gap:5px;
                    text-decoration:none;">

                    <i class="ti ti-search" aria-hidden="true"></i>
                    Browse items
                </a>

                @if (isLoggedIn)
                {
                    <a href="/seller/listings/create"
                       style="background:#fff;
                        color:#4B3BC7;
                        border:1.5px solid #4B3BC7;
                        border-radius:6px;
                        padding:9px 18px;
                        font-size:12px;
                        font-weight:500;
                        display:flex;
                        align-items:center;
                        gap:5px;
                        text-decoration:none;">

                        <i class="ti ti-plus" aria-hidden="true"></i>
                        Sell an item
                    </a>
                }
                else
                {
                    <a href="/auth/register"
                       style="background:#fff;
                        color:#4B3BC7;
                        border:1.5px solid #4B3BC7;
                        border-radius:6px;
                        padding:9px 18px;
                        font-size:12px;
                        font-weight:500;
                        display:flex;
                        align-items:center;
                        gap:5px;
                        text-decoration:none;">

                        <i class="ti ti-plus" aria-hidden="true"></i>
                        Sell an item
                    </a>
                }

            </div>

            @* Trust icons *@
            <div style="display:grid;
                grid-template-columns:repeat(4,1fr);
                gap:8px;">

                @{
                    var trustItems = new[]
                    {
                        ("ti-shield-check", "Safe & Secure", "Verified student community"),
                        ("ti-message-dots", "Chat easily", "Message buyers & sellers"),
                        ("ti-star", "Trusted reviews", "Rate and review users"),
                        ("ti-users", "Student community", "Built for students")
                    };
                }

                @foreach (var (icon, label, sub) in trustItems)
                {
                    <div style="display:flex;
                        flex-direction:column;
                        align-items:center;
                        gap:4px;
                        text-align:center;">

                        <div style="width:32px;
                            height:32px;
                            background:#EEEDFE;
                            border-radius:50%;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            color:#4B3BC7;
                            font-size:15px;">

                            <i class="ti @icon" aria-hidden="true"></i>

                        </div>

                        <div style="font-size:10px;
                            color:#555;
                            font-weight:500;">
                            @label
                        </div>

                        <div style="font-size:10px;
                            color:#888;">
                            @sub
                        </div>

                    </div>
                }

            </div>
        </div>

        @* Right hero panel *@
        <div style="background:#EEEDFE;
            border-radius:12px;
            overflow:hidden;
            position:relative;
            min-height:200px;
            display:flex;
            flex-direction:column;
            justify-content:flex-end;">

            <div style="width:100%;
                height:160px;
                background:#dddaf6;
                display:flex;
                align-items:center;
                justify-content:center;
                color:#7F77DD;
                font-size:32px;">

                <i class="ti ti-photo" aria-hidden="true"></i>

            </div>

            @* Dots *@
            <div style="display:flex;
                gap:5px;
                justify-content:center;
                padding:8px 0 4px;
                background:#EEEDFE;">

                <div style="width:16px;
                height:6px;
                border-radius:4px;
                background:#4B3BC7;"></div>

                <div style="width:6px;
                height:6px;
                border-radius:50%;
                background:#AFA9EC;"></div>

                <div style="width:6px;
                height:6px;
                border-radius:50%;
                background:#AFA9EC;"></div>

                <div style="width:6px;
                height:6px;
                border-radius:50%;
                background:#AFA9EC;"></div>

            </div>

            @* Dynamic platform statistics *@
            @{
                var activeStudents =
                    (int)(ViewBag.ActiveStudents ?? 0);

                var itemsListed =
                    (int)(ViewBag.ItemsListed ?? 0);

                var tradesDone =
                    (int)(ViewBag.TradesDone ?? 0);

                var verificationRate =
                    (int)(ViewBag.VerificationRate ?? 0);

                string FormatStat(int value)
                {
                    return value >= 1000
                        ? $"{value / 1000.0:0.#}K+"
                        : value.ToString("N0");
                }
            }

            <div style="display:grid;
                grid-template-columns:repeat(4,1fr);
                background:#26215C;
                padding:10px 8px;
                gap:4px;">

                <div style="text-align:center;">
                    <div style="font-size:13px;
                        font-weight:500;
                        color:#fff;">
                        @FormatStat(activeStudents)
                    </div>

                    <div style="font-size:10px;
                        color:#AFA9EC;">
                        Active students
                    </div>
                </div>

                <div style="text-align:center;">
                    <div style="font-size:13px;
                        font-weight:500;
                        color:#fff;">
                        @FormatStat(itemsListed)
                    </div>

                    <div style="font-size:10px;
                        color:#AFA9EC;">
                        Items listed
                    </div>
                </div>

                <div style="text-align:center;">
                    <div style="font-size:13px;
                        font-weight:500;
                        color:#fff;">
                        @FormatStat(tradesDone)
                    </div>

                    <div style="font-size:10px;
                        color:#AFA9EC;">
                        Trades done
                    </div>
                </div>

                <div style="text-align:center;">
                    <div style="font-size:13px;
                        font-weight:500;
                        color:#fff;">
                        @verificationRate%
                    </div>

                    <div style="font-size:10px;
                        color:#AFA9EC;">
                        Verified
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div style="height:0.5px;background:#e0ddf5;"></div>

    @* ── SHOP BY CATEGORY ───────────────────────────────────── *@
    <div style="background:#fff;
        padding:24px 30px;">

        <div style="display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:16px;">

            <div style="font-size:17px;
                font-weight:500;
                color:#26215C;">
                Shop by category
            </div>

            <a href="/listings/browse"
               style="font-size:14px;
                color:#4B3BC7;
                text-decoration:none;">

                View all categories
                <i class="ti ti-arrow-right"
                   aria-hidden="true"
                   style="font-size:14px;"></i>

            </a>
        </div>

        <div style="display:flex;
            gap:12px;
            flex-wrap:wrap;">

            @{
                var cats = new[]
                {
                    ("ti-device-laptop", "Electronics"),
                    ("ti-device-mobile", "Phones"),
                    ("ti-book", "Textbooks"),
                    ("ti-hanger", "Clothing"),
                    ("ti-shoe", "Shoes"),
                    ("ti-sofa", "Room essentials"),
                    ("ti-tool-kitchen-2", "Kitchen"),
                    ("ti-barbell", "Sports & fitness"),
                    ("ti-briefcase", "Services"),
                    ("ti-dots", "Other")
                };
            }

            @foreach (var (icon, label) in cats)
            {
                <a href="/listings/browse?category=@label"
                   style="display:flex;
                    flex-direction:column;
                    align-items:center;
                    gap:12px;
                    background:#fff;
                    border:0.5px solid #e0ddf5;
                    border-radius:10px;
                    padding:10px 12px;
                    min-width:60px;
                    cursor:pointer;
                    text-decoration:none;">

                    <div style="width:36px;
                        height:36px;
                        background:#EEEDFE;
                        border-radius:8px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        color:#4B3BC7;
                        font-size:18px;">

                        <i class="ti @icon"
                           aria-hidden="true"></i>

                    </div>

                    <div style="font-size:10px;
                        color:#444;
                        text-align:center;">
                        @label
                    </div>

                </a>
            }

        </div>
    </div>

    <div style="height:0.5px;background:#e0ddf5;"></div>

    @* ── RECENTLY ADDED ─────────────────────────────────────── *@
    <div style="background:#f5f4f9;
        padding:22px 26px;">

        <div style="display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:14px;">

            <div style="font-size:15px;
                font-weight:500;
                color:#26215C;">
                Recently added
            </div>

            <a href="/listings/browse"
               style="font-size:12px;
                color:#4B3BC7;
                text-decoration:none;">

                View all listings
                <i class="ti ti-arrow-right"
                   aria-hidden="true"
                   style="font-size:12px;"></i>

            </a>
        </div>

        @if (recentListings.Any())
        {
            <div style="display:grid;
                grid-template-columns:repeat(4,minmax(0,1fr));
                gap:14px;">

                @foreach (var listing in recentListings.Take(4))
                {
                    var daysAgo =
                        (int)(DateTime.UtcNow - listing.CreatedAt).TotalDays;

                    var timeAgo =
                        daysAgo == 0
                            ? "Today"
                            : daysAgo == 1
                                ? "1d ago"
                                : $"{daysAgo}d ago";

                    <a href="/listings/@listing.ListingId"
                       style="background:#fff;
                        border:0.5px solid #e0ddf5;
                        border-radius:10px;
                        overflow:hidden;
                        cursor:pointer;
                        text-decoration:none;
                        color:inherit;
                        display:block;">

                        <div style="background:#f0eefb;
                            height:140px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            color:#7F77DD;
                            position:relative;">

                            @if (!string.IsNullOrEmpty(listing.CoverImageUrl))
                            {
                                <img src="@listing.CoverImageUrl"
                                     alt="@listing.Title"
                                     style="width:100%;
                                    height:100%;
                                    object-fit:cover;" />
                            }
                            else
                            {
                                <i class="ti ti-photo"
                                   aria-hidden="true"
                                   style="font-size:36px;"></i>
                            }

                            <div style="position:absolute;
                                top:6px;
                                right:6px;
                                color:#bbb;
                                font-size:14px;">

                                <i class="ti ti-heart"
                                   aria-hidden="true"></i>

                            </div>
                        </div>

                        <div style="padding:8px 10px;">

                            <div style="font-size:12px;
                                font-weight:500;
                                color:#26215C;
                                margin-bottom:2px;
                                white-space:nowrap;
                                overflow:hidden;
                                text-overflow:ellipsis;">
                                @listing.Title
                            </div>

                            <div style="font-size:13px;
                                font-weight:500;
                                color:#4B3BC7;
                                margin-bottom:3px;">
                                R @listing.Price.ToString("N0")
                            </div>

                            <div style="font-size:10px;
                                color:#888;
                                display:flex;
                                align-items:center;
                                gap:4px;">

                                <i class="ti ti-map-pin"
                                   aria-hidden="true"></i>

                                @listing.UniversityShortName · @timeAgo
                            </div>

                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div style="background:#fff;
                border:0.5px solid #e0ddf5;
                border-radius:10px;
                padding:30px;
                text-align:center;
                font-size:12px;
                color:#888;">

                No listings yet at your campus.

                <a href="/seller/listings/create"
                   style="color:#4B3BC7;">
                    Be the first to sell something →
                </a>

            </div>
        }

    </div>

    <div style="height:0.5px;background:#e0ddf5;"></div>

    @* ── FEATURED LISTINGS ──────────────────────────────────── *@
    @if (featuredListings.Any())
    {
        <div style="background:#fff;
            padding:20px 24px;">

            <div style="display:flex;
                justify-content:space-between;
                align-items:center;
                margin-bottom:14px;">

                <div style="font-size:15px;
                    font-weight:500;
                    color:#26215C;">
                    Featured listings
                </div>

                <a href="/listings/browse"
                   style="font-size:12px;
                    color:#4B3BC7;
                    text-decoration:none;">

                    View all listings
                    <i class="ti ti-arrow-right"
                       aria-hidden="true"
                       style="font-size:12px;"></i>

                </a>
            </div>

            <div style="display:grid;
                grid-template-columns:repeat(4,minmax(0,1fr));
                gap:14px;">

                @foreach (var listing in featuredListings.Take(4))
                {
                    var daysAgo =
                        (int)(DateTime.UtcNow - listing.CreatedAt).TotalDays;

                    var timeAgo =
                        daysAgo == 0
                            ? "Today"
                            : daysAgo == 1
                                ? "1d ago"
                                : $"{daysAgo}d ago";

                    <a href="/listings/@listing.ListingId"
                       style="background:#fff;
                        border:0.5px solid #e0ddf5;
                        border-radius:10px;
                        overflow:hidden;
                        cursor:pointer;
                        text-decoration:none;
                        color:inherit;
                        display:block;">

                        <div style="background:#dddaf6;
                            height:140px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            color:#7F77DD;
                            position:relative;">

                           @if (!string.IsNullOrEmpty(listing.CoverImageUrl))
                            {
                                <img src="@ImageHelper.ResolveUrl(listing.CoverImageUrl)"
                                     alt="@listing.Title"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <i class="ti ti-photo"
                                   aria-hidden="true"
                                   style="font-size:36px;"></i>
                            }

                            <div style="position:absolute;
                                top:6px;
                                left:6px;
                                background:#4B3BC7;
                                color:#fff;
                                font-size:9px;
                                padding:2px 6px;
                                border-radius:4px;">
                                Featured
                            </div>

                            <div style="position:absolute;
                                top:6px;
                                right:6px;
                                color:#bbb;
                                font-size:14px;">

                                <i class="ti ti-heart"
                                   aria-hidden="true"></i>

                            </div>

                        </div>

                        <div style="padding:8px 10px;">

                            <div style="font-size:12px;
                                font-weight:500;
                                color:#26215C;
                                margin-bottom:2px;
                                white-space:nowrap;
                                overflow:hidden;
                                text-overflow:ellipsis;">
                                @listing.Title
                            </div>

                            <div style="font-size:13px;
                                font-weight:500;
                                color:#4B3BC7;
                                margin-bottom:3px;">
                                R @listing.Price.ToString("N0")
                            </div>

                            <div style="font-size:10px;
                                color:#888;
                                display:flex;
                                align-items:center;
                                gap:4px;">

                                <i class="ti ti-map-pin"
                                   aria-hidden="true"></i>

                                @listing.UniversityShortName · @timeAgo
                            </div>

                        </div>
                    </a>
                }

            </div>
        </div>

        <div style="height:0.5px;background:#e0ddf5;"></div>
    }

    @* ── HOW IT WORKS ───────────────────────────────────────── *@
    <div style="background:#f5f4f9;
        padding:20px 24px;">

        <div style="text-align:center;
            margin-bottom:20px;">

            <div style="font-size:15px;
                font-weight:500;
                color:#26215C;">
                How Varsity Trade works
            </div>

        </div>

        <div style="display:grid;
            grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;
            align-items:start;
            gap:4px;">

            @{
                var steps = new[]
                {
                    (
                        "ti-user-plus",
                        "1. Create account",
                        "Sign up with your student email and verify your profile."
                    ),
                    (
                        "ti-shopping-bag",
                        "2. List or find items",
                        "Post items you want to sell or browse what you need."
                    ),
                    (
                        "ti-message-dots",
                        "3. Chat & negotiate",
                        "Message, ask questions and agree on the deal."
                    ),
                    (
                        "ti-circle-check",
                        "4. Meet & exchange",
                        "Meet safely on campus and complete the trade."
                    )
                };
            }

            @for (int i = 0; i < steps.Length; i++)
            {
                var (icon, title, desc) = steps[i];

                <div style="display:flex;
                    flex-direction:column;
                    align-items:center;
                    text-align:center;
                    gap:8px;">

                    <div style="width:48px;
                        height:48px;
                        background:#EEEDFE;
                        border-radius:50%;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        color:#4B3BC7;
                        font-size:22px;">

                        <i class="ti @icon"
                           aria-hidden="true"></i>

                    </div>

                    <div style="font-size:11px;
                        color:#4B3BC7;
                        font-weight:500;">
                        @title
                    </div>

                    <div style="font-size:11px;
                        color:#888;
                        line-height:1.4;">
                        @desc
                    </div>

                </div>

                @if (i < steps.Length - 1)
                {
                    <div style="display:flex;
                        align-items:center;
                        justify-content:center;
                        color:#ccc;
                        font-size:18px;
                        padding-top:14px;">

                        <i class="ti ti-arrow-right"
                           aria-hidden="true"></i>

                    </div>
                }
            }

        </div>
    </div>

    <div style="height:0.5px;background:#e0ddf5;"></div>

    @* ── SELL BANNER ────────────────────────────────────────── *@
    <div style="padding:20px 24px;
        background:#fff;">

        <div style="background:#4B3BC7;
            border-radius:12px;
            padding:20px 24px;
            display:flex;
            align-items:center;
            justify-content:space-between;">

            <div>
                <div style="font-size:16px;
                    font-weight:500;
                    color:#fff;
                    margin-bottom:4px;">
                    Turn your stuff into cash
                </div>

                <div style="font-size:12px;
                    color:#AFA9EC;
                    line-height:1.5;">
                    Got items you no longer need? List them in minutes<br>
                    and reach thousands of students around you.
                </div>
            </div>

            <div style="display:flex;
                gap:8px;
                align-items:center;
                margin:0 20px;">

                @foreach (var icon in new[]
                {
                    "ti-backpack",
                    "ti-book",
                    "ti-device-laptop"
                })
                {
                    <div style="width:44px;
                        height:44px;
                        background:#3C3489;
                        border-radius:8px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        color:#AFA9EC;
                        font-size:18px;">

                        <i class="ti @icon"
                           aria-hidden="true"></i>

                    </div>
                }

            </div>

            @if (isLoggedIn)
            {
                <a href="/seller/listings/create"
                   style="background:#fff;
                    color:#4B3BC7;
                    border:none;
                    border-radius:6px;
                    padding:10px 18px;
                    font-size:12px;
                    font-weight:500;
                    white-space:nowrap;
                    text-decoration:none;">
                    Sell an item now
                </a>
            }
            else
            {
                <a href="/auth/register"
                   style="background:#fff;
                    color:#4B3BC7;
                    border:none;
                    border-radius:6px;
                    padding:10px 18px;
                    font-size:12px;
                    font-weight:500;
                    white-space:nowrap;
                    text-decoration:none;">
                    Sell an item now
                </a>
            }

        </div>
    </div>

    <div style="height:0.5px;background:#e0ddf5;"></div>

    @* ── REVIEWS SECTION ────────────────────────────────────── *@
    @{
        var reviews =
            ViewBag.Reviews as List<VarsityTrade.Web.Models.Seller.SellerDashboardViewModel.SellerReviewViewModel>
            ?? new List<VarsityTrade.Web.Models.Seller.SellerDashboardViewModel.SellerReviewViewModel>();
    }

    @if (reviews.Any())
    {
        <div style="background:#fff;
            padding:20px 24px;">

            <div style="display:flex;
                justify-content:space-between;
                align-items:center;
                margin-bottom:14px;">

                <div style="font-size:15px;
                    font-weight:500;
                    color:#26215C;">
                    What students say
                </div>

            </div>

            <div style="display:grid;
                grid-template-columns:repeat(3,1fr);
                gap:12px;">

                @foreach (var review in reviews)
                {
                    var reviewerName =
                        $"{review.ReviewerFirstName} {review.ReviewerLastName}".Trim();

                    if (string.IsNullOrWhiteSpace(reviewerName))
                    {
                        reviewerName = "Student";
                    }

                    var initials = "ST";

                    if (!string.IsNullOrWhiteSpace(review.ReviewerFirstName) &&
                        !string.IsNullOrWhiteSpace(review.ReviewerLastName))
                    {
                        initials =
                            $"{review.ReviewerFirstName[0]}{review.ReviewerLastName[0]}"
                            .ToUpper();
                    }
                    else if (!string.IsNullOrWhiteSpace(review.ReviewerFirstName))
                    {
                        initials =
                            review.ReviewerFirstName.Substring(0, 1).ToUpper();
                    }
                    else if (!string.IsNullOrWhiteSpace(review.ReviewerLastName))
                    {
                        initials =
                            review.ReviewerLastName.Substring(0, 1).ToUpper();
                    }

                    <div style="background:#fff;
                        border:0.5px solid var(--vt-border);
                        border-radius:var(--vt-radius-lg);
                        padding:16px;">

                        <div style="display:flex;
                            align-items:center;
                            gap:10px;
                            margin-bottom:10px;">

                            <div style="width:36px;
                                height:36px;
                                background:var(--vt-primary-light);
                                border-radius:50%;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                color:var(--vt-primary);
                                font-size:12px;
                                font-weight:500;">

                                @initials

                            </div>

                            <div>
                                <div style="font-size:12px;
                                    font-weight:500;
                                    color:var(--vt-text-primary);">

                                    @reviewerName

                                </div>

                                <div style="font-size:10px;
                                    color:var(--vt-text-muted);">

                                    @review.StoreName

                                </div>
                            </div>

                        </div>

                        <div style="color:#F59E0B;
                            font-size:12px;
                            margin-bottom:8px;">

                            @for (var i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <i class="ti ti-star-filled"
                                       aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="ti ti-star"
                                       aria-hidden="true"></i>
                                }
                            }

                        </div>

                        <div style="font-size:12px;
                            color:var(--vt-text-secondary);
                            line-height:1.5;
                            margin-bottom:8px;">

                            @(string.IsNullOrWhiteSpace(review.Comment)
                                ? "No comment provided."
                                : review.Comment)

                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.ListingTitle))
                        {
                            <div style="font-size:10px;
                                color:var(--vt-text-muted);">

                                Review for: @review.ListingTitle

                            </div>
                        }

                    </div>
                }

            </div>
        </div>

        <div style="height:0.5px;background:#e0ddf5;"></div>
    }

    @* ── NEWSLETTER ─────────────────────────────────────────── *@
    <div style="background:#EEEDFE;
        padding:18px 24px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;">

        <div>
            <div style="font-size:14px;
                font-weight:500;
                color:#26215C;
                margin-bottom:3px;">
                Stay in the loop
            </div>

            <div style="font-size:12px;
                color:#534AB7;">
                Get the latest deals, tips and updates straight to your inbox.
            </div>
        </div>

        <div style="display:flex;
            gap:8px;
