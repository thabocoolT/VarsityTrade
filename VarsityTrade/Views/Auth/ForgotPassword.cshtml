@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div style="display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 80px);">

    @* LEFT — purple gradient with step flow *@
    <div style="background:linear-gradient(145deg,#4B3BC7,#26215C);padding:36px;display:flex;flex-direction:column;justify-content:space-between;">
        <div>
            <div style="font-size:22px;font-weight:500;color:#fff;margin-bottom:8px;line-height:1.3;">
                Reset your<br><span style="color:#AFA9EC;">password.</span>
            </div>
            <div style="font-size:12px;color:#AFA9EC;line-height:1.7;margin-bottom:24px;">
                Follow the simple steps on the right to regain access to your Varsity Trade account.
            </div>

            @* Step flow *@
            <div style="display:flex;flex-direction:column;gap:0;">
                @foreach (var (num, title, sub, isActive) in new[] {
                    ("1", "Enter your email",    "We'll send a password reset link to your registered email address.", true),
                    ("2", "Check your email",    "Open the email from Varsity Trade and enter the OTP code.", false),
                    ("3", "Set a new password",  "Choose a strong new password and log back in to your account.", false),
                })
                {
                    <div style="display:flex;align-items:flex-start;gap:12px;position:relative;padding-bottom:@(num!="3"?"20px":"0");">
                        <div style="display:flex;flex-direction:column;align-items:center;gap:0;">
                            <div style="width:28px;height:28px;border-radius:50%;@(isActive?"background:#fff;color:#4B3BC7;":"background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.3);")display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500;flex-shrink:0;">@num</div>
                            @if (num != "3")
                            {
                                <div style="width:1px;flex:1;background:rgba(255,255,255,0.15);min-height:20px;margin:4px 0;"></div>
                            }
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:500;color:#fff;margin-bottom:2px;">@title</div>
                            <div style="font-size:11px;color:#AFA9EC;line-height:1.5;">@sub</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div style="font-size:11px;color:#7F77DD;margin-top:20px;">© 2025 Varsity Trade. All rights reserved.</div>
    </div>

    @* RIGHT — form steps *@
    <div style="background:#fff;padding:32px 36px;display:flex;flex-direction:column;justify-content:center;">

        @* Step tabs *@
        <div style="display:flex;gap:0;border-bottom:0.5px solid #e0ddf5;margin-bottom:20px;">
            @foreach (var (tab, active) in new[] { ("Step 1 — Request reset", true), ("Step 2 — Verify code", false), ("Step 3 — New password", false) })
            {
                <div style="padding:8px 16px;font-size:12px;@(active?"color:#4B3BC7;border-bottom:2px solid #4B3BC7;font-weight:500;":"color:#888;border-bottom:2px solid transparent;")cursor:pointer;">@tab</div>
            }
        </div>

        @* Step 1 *@
        <div>
            <div style="font-size:17px;font-weight:500;color:#26215C;margin-bottom:4px;">Forgot your password?</div>
            <div style="font-size:12px;color:#888;margin-bottom:16px;line-height:1.6;">Enter the email address linked to your Varsity Trade account and we will send you a reset link.</div>

            <form method="post">
                @Html.AntiForgeryToken()
                <div style="margin-bottom:12px;">
                    <label style="font-size:11px;color:#555;margin-bottom:4px;display:block;">Email address</label>
                    <input type="email" name="email" placeholder="e.g. thabo@gmail.com"
                           style="width:100%;border:0.5px solid #4B3BC7;border-radius:7px;padding:9px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                    <div style="font-size:10px;color:#888;margin-top:3px;">Must match the email you registered with.</div>
                </div>
                <button type="submit" style="width:100%;background:#4B3BC7;color:#fff;border:none;border-radius:8px;padding:11px;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:10px;">
                    <i class="ti ti-send" aria-hidden="true"></i> Send reset link
                </button>
            </form>

            <div style="font-size:12px;color:#888;text-align:center;display:flex;align-items:center;justify-content:center;gap:4px;">
                <i class="ti ti-arrow-left" aria-hidden="true" style="font-size:13px;"></i>
                <a href="/auth/login" style="color:#4B3BC7;font-weight:500;">Back to login</a>
            </div>
        </div>
    </div>
</div>