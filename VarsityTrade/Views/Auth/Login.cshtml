@model VarsityTrade.Web.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_Layout";
}

@section Styles {
    <style>
        main { padding: 0 !important; }
        .vt-body-no-sidebar { padding: 0 !important; }
    </style>
}

<div style="display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 80px);">

    @* LEFT — purple gradient with features *@
    <div style="background:linear-gradient(145deg,#4B3BC7,#26215C);padding:36px;display:flex;flex-direction:column;justify-content:space-between;">
        <div>
            <div style="font-size:22px;font-weight:500;color:#fff;margin-bottom:8px;line-height:1.3;">
                Welcome back<br><span style="color:#AFA9EC;">to Varsity Trade.</span>
            </div>
            <div style="font-size:12px;color:#AFA9EC;line-height:1.7;margin-bottom:24px;">
                Log in to access your campus marketplace — browse listings, message sellers, and manage your trades.
            </div>
            <div style="display:flex;flex-direction:column;gap:14px;">
                @foreach (var (icon, title, sub) in new[] {
                    ("ti-building",         "Campus-locked marketplace",      "See only listings from students at your university — safe and trusted."),
                    ("ti-message-dots",     "Message sellers directly",       "Chat with sellers, negotiate prices, and arrange campus pickups."),
                    ("ti-arrows-exchange",  "Buy and sell in one account",    "Switch between buying and selling without needing a second account."),
                })
                {
                    <div style="display:flex;align-items:flex-start;gap:10px;">
                        <div style="width:32px;height:32px;background:rgba(255,255,255,0.12);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;flex-shrink:0;">
                            <i class="ti @icon" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:500;color:#fff;margin-bottom:2px;">@title</div>
                            <div style="font-size:11px;color:#AFA9EC;line-height:1.5;">@sub</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div style="font-size:11px;color:#7F77DD;margin-top:20px;">© 2025 Varsity Trade. All rights reserved.</div>
    </div>

    @* RIGHT — login form *@
    <div style="background:#fff;padding:32px 36px;display:flex;flex-direction:column;justify-content:center;">
        <div style="font-size:18px;font-weight:500;color:#26215C;margin-bottom:4px;">Log in to your account</div>
        <div style="font-size:12px;color:#888;margin-bottom:20px;">Enter your email and password to continue.</div>

        <div style="background:#EEEDFE;border:0.5px solid #AFA9EC;border-radius:7px;padding:8px 10px;font-size:11px;color:#3C3489;display:flex;align-items:flex-start;gap:6px;margin-bottom:16px;">
            <i class="ti ti-shield-check" aria-hidden="true" style="font-size:14px;margin-top:1px;flex-shrink:0;"></i>
            Your university is linked to your account — logging in gives you access to your campus marketplace only.
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background:#FDECEA;border:0.5px solid #F5A8A8;border-radius:7px;padding:8px 10px;font-size:11px;color:#B91C1C;display:flex;align-items:center;gap:6px;margin-bottom:12px;">
                <i class="ti ti-alert-circle" aria-hidden="true"></i> @Model.ErrorMessage
            </div>
        }

        <form asp-action="Login" asp-controller="Auth" asp-route-area="" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:12px;">
                <div style="font-size:11px;color:#555;margin-bottom:4px;">Email address</div>
                <input asp-for="Email" type="text" placeholder="e.g. thabo@gmail.com"
                       style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:9px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                <span asp-validation-for="Email" style="font-size:10px;color:#e74c3c;display:block;margin-top:3px;"></span>
            </div>

            <div style="margin-bottom:12px;">
                <div style="font-size:11px;color:#555;margin-bottom:4px;display:flex;justify-content:space-between;">
                    <span>Password</span>
                    <a href="/auth/forgot-password" style="font-size:11px;color:#4B3BC7;text-decoration:none;">Forgot password?</a>
                </div>
                <input asp-for="Password" type="password" placeholder="Enter your password"
                       style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:9px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                <span asp-validation-for="Password" style="font-size:10px;color:#e74c3c;display:block;margin-top:3px;"></span>
            </div>

            <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#666;margin-bottom:14px;">
                <input type="checkbox" style="width:14px;height:14px;border:0.5px solid #aaa;border-radius:3px;" />
                Remember me on this device
            </div>

            <button type="submit" style="width:100%;background:#4B3BC7;color:#fff;border:none;border-radius:8px;padding:11px;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">
                <i class="ti ti-login" aria-hidden="true"></i> Log in
            </button>
        </form>

        <div style="display:flex;align-items:center;gap:10px;margin:14px 0;">
            <div style="flex:1;height:0.5px;background:#e0ddf5;"></div>
            <span style="font-size:11px;color:#aaa;white-space:nowrap;">or continue with</span>
            <div style="flex:1;height:0.5px;background:#e0ddf5;"></div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;">
            <button style="border:0.5px solid #ddd;border-radius:7px;padding:8px;font-size:12px;color:#444;background:#fff;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;">
                <i class="ti ti-brand-google" aria-hidden="true" style="color:#EA4335;"></i> Google
            </button>
            <button style="border:0.5px solid #ddd;border-radius:7px;padding:8px;font-size:12px;color:#444;background:#fff;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;">
                <i class="ti ti-brand-facebook" aria-hidden="true" style="color:#1877F2;"></i> Facebook
            </button>
        </div>

        <div style="font-size:12px;color:#888;text-align:center;">
            Don't have an account? <a href="/auth/register" style="color:#4B3BC7;font-weight:500;">Register for free</a>
        </div>
    </div>
</div>