@model VarsityTrade.Web.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_Layout";
}

<div style="display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 80px);">

    @* LEFT — purple gradient with features *@
    <div style="background:linear-gradient(145deg,#4B3BC7,#26215C);padding:40px 36px;display:flex;flex-direction:column;justify-content:space-between;">
        <div>
            <div style="font-size:22px;font-weight:500;color:#fff;margin-bottom:8px;line-height:1.3;">
                Join Varsity Trade<br><span style="color:#AFA9EC;">— it's free.</span>
            </div>
            <div style="font-size:12px;color:#AFA9EC;line-height:1.7;margin-bottom:28px;">
                Buy, sell and trade with students at your university. Safe, local, and trusted.
            </div>
            <div style="display:flex;flex-direction:column;gap:14px;">
                @foreach (var (icon, title, sub) in new[] {
                    ("ti-shield-check",    "Campus-locked marketplace",  "Only students from your university can see and buy your listings — keeping it safe and local."),
                    ("ti-map-pin",         "Res & suburb pickup",        "Your residence and suburb are used to coordinate safe pickups and deliveries on campus."),
                    ("ti-arrows-exchange", "Buy and sell in one account","Start as a buyer and activate your seller profile whenever you are ready — no second account needed."),
                    ("ti-star",            "Trusted reviews",            "Build your reputation with verified student reviews after every successful trade."),
                })
                {
                    <div style="display:flex;align-items:flex-start;gap:10px;">
                        <div style="width:32px;height:32px;background:rgba(255,255,255,0.12);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;flex-shrink:0;">
                            <i class="ti @icon" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:500;color:#fff;margin-bottom:2px;">@title</div>
                            <div style="font-size:11px;color:#AFA9EC;line-height:1.5;">@sub</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div style="font-size:11px;color:#7F77DD;margin-top:24px;">© 2025 Varsity Trade. All rights reserved.</div>
    </div>

    @* RIGHT — registration form *@
    <div style="background:#fff;padding:32px 36px;display:flex;flex-direction:column;justify-content:center;overflow-y:auto;">
        <div style="font-size:18px;font-weight:500;color:#26215C;margin-bottom:4px;">Create your account</div>
        <div style="font-size:12px;color:#888;margin-bottom:20px;">Fill in your details below — takes less than 2 minutes.</div>

        @* Step indicator *@
        <div style="display:flex;align-items:center;gap:0;margin-bottom:24px;">
            @foreach (var (num, lbl) in new[] { ("1", "Personal info"), ("2", "University"), ("3", "Location"), ("4", "Password") })
            {
                var isFirst = num == "1";
                <div style="display:flex;align-items:center;gap:6px;flex:1;">
                    <div style="width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;flex-shrink:0;@(isFirst ? "background:#4B3BC7;color:#fff;box-shadow:0 0 0 3px #EEEDFE;" : "background:#f5f4f9;color:#aaa;border:0.5px solid #ddd;")">@num</div>
                    <span style="font-size:10px;@(isFirst ? "color:#4B3BC7;font-weight:500;" : "color:#888;")white-space:nowrap;">@lbl</span>
                </div>
                @if (num != "4")
                {
                    <div style="flex:1;height:1px;background:#e0ddf5;margin:0 6px;"></div>
                }
            }
        </div>

        <form asp-action="Register" asp-controller="Auth" asp-route-area="" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="background:#FDECEA;border:0.5px solid #F5A8A8;border-radius:7px;padding:8px 10px;font-size:11px;color:#B91C1C;margin-bottom:12px;display:@(ViewData.ModelState.IsValid ? "none" : "block");"></div>

            @* Step 1 — Personal info *@
            <div style="margin-bottom:16px;">
                <div style="font-size:11px;font-weight:500;color:#4B3BC7;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;display:flex;align-items:center;gap:5px;">
                    <i class="ti ti-user" aria-hidden="true"></i> Step 1 — Personal information
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
                    <div>
                        <div style="font-size:11px;color:#555;margin-bottom:4px;">First name <span style="color:#e74c3c;">*</span></div>
                        <input asp-for="FirstName" type="text" placeholder="e.g. Thabo"
                               style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                        <span asp-validation-for="FirstName" style="font-size:10px;color:#e74c3c;display:block;margin-top:3px;"></span>
                    </div>
                    <div>
                        <div style="font-size:11px;color:#555;margin-bottom:4px;">Last name <span style="color:#e74c3c;">*</span></div>
                        <input asp-for="LastName" type="text" placeholder="e.g. Cool Tee"
                               style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                        <span asp-validation-for="LastName" style="font-size:10px;color:#e74c3c;display:block;margin-top:3px;"></span>
                    </div>
                </div>
                <div style="margin-bottom:10px;">
                    <div style="font-size:11px;color:#555;margin-bottom:4px;">Email address <span style="color:#e74c3c;">*</span></div>
                    <input asp-for="Email" type="email" placeholder="e.g. thabo@gmail.com"
                           style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                    <div style="font-size:10px;color:#888;margin-top:3px;">Use any valid email address. University email not required.</div>
                    <span asp-validation-for="Email" style="font-size:10px;color:#e74c3c;display:block;"></span>
                </div>
            </div>

            <div style="height:0.5px;background:#e0ddf5;margin:14px 0;"></div>

            @* Step 2 — University *@
            <div style="margin-bottom:16px;">
                <div style="font-size:11px;font-weight:500;color:#4B3BC7;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;display:flex;align-items:center;gap:5px;">
                    <i class="ti ti-building" aria-hidden="true"></i> Step 2 — University
                </div>
                <div>
                    <div style="font-size:11px;color:#555;margin-bottom:4px;">University / College <span style="color:#e74c3c;">*</span></div>
                    <select asp-for="UniversityId" style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;">
                        <option value="">Select your university...</option>
                        @foreach (var uni in Model.Universities)
                        {
                            <option value="@uni.UniversityId">@uni.Name</option>
                        }
                    </select>
                    <div style="font-size:10px;color:#888;margin-top:3px;">
                        <i class="ti ti-lock" aria-hidden="true"></i>
                        This locks your marketplace to your campus — you will only see listings from your university.
                    </div>
                    <span asp-validation-for="UniversityId" style="font-size:10px;color:#e74c3c;display:block;"></span>
                </div>
            </div>

            <div style="height:0.5px;background:#e0ddf5;margin:14px 0;"></div>

            @* Step 3 — Location *@
            <div style="margin-bottom:16px;">
                <div style="font-size:11px;font-weight:500;color:#4B3BC7;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;display:flex;align-items:center;gap:5px;">
                    <i class="ti ti-map-pin" aria-hidden="true"></i> Step 3 — Location & pickup
                </div>
                <div style="background:#EEEDFE;border:0.5px solid #AFA9EC;border-radius:7px;padding:8px 10px;font-size:11px;color:#3C3489;display:flex;align-items:flex-start;gap:6px;margin-bottom:10px;">
                    <i class="ti ti-info-circle" aria-hidden="true" style="font-size:14px;margin-top:1px;flex-shrink:0;"></i>
                    Your suburb and residence are shown to buyers and sellers to help arrange safe campus pickups. Never shared outside Varsity Trade.
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
                    <div>
                        <div style="font-size:11px;color:#555;margin-bottom:4px;">Suburb <span style="color:#e74c3c;">*</span></div>
                        <input asp-for="Suburb" type="text" placeholder="e.g. Hatfield"
                               style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                        <span asp-validation-for="Suburb" style="font-size:10px;color:#e74c3c;display:block;"></span>
                    </div>
                    <div>
                        <div style="font-size:11px;color:#555;margin-bottom:4px;">City <span style="color:#e74c3c;">*</span></div>
                        <input asp-for="City" type="text" placeholder="e.g. Pretoria"
                               style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                        <span asp-validation-for="City" style="font-size:10px;color:#e74c3c;display:block;"></span>
                    </div>
                </div>
                <div style="margin-bottom:10px;">
                    <div style="font-size:11px;color:#555;margin-bottom:4px;">Province <span style="color:#e74c3c;">*</span></div>
                    <input asp-for="Province" type="text" placeholder="e.g. Gauteng"
                           style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                    <span asp-validation-for="Province" style="font-size:10px;color:#e74c3c;display:block;"></span>
                </div>
                <div>
                    <div style="font-size:11px;color:#555;margin-bottom:4px;">Residence (Res) name</div>
                    <input asp-for="ResidenceName" type="text" placeholder="e.g. Jubilee Residence"
                           style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                    <div style="font-size:10px;color:#888;margin-top:3px;">Optional but recommended — helps buyers know where to meet you.</div>
                </div>
            </div>

            <div style="height:0.5px;background:#e0ddf5;margin:14px 0;"></div>

            @* Step 4 — Password *@
            <div style="margin-bottom:16px;">
                <div style="font-size:11px;font-weight:500;color:#4B3BC7;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;display:flex;align-items:center;gap:5px;">
                    <i class="ti ti-lock" aria-hidden="true"></i> Step 4 — Password
                </div>
                <div style="margin-bottom:10px;">
                    <div style="font-size:11px;color:#555;margin-bottom:4px;">Password <span style="color:#e74c3c;">*</span></div>
                    <input asp-for="Password" type="password" placeholder="Create a strong password" id="passwordInput"
                           style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                    @* Password strength bar *@
                    <div style="height:4px;background:#f0eefb;border-radius:2px;overflow:hidden;margin:5px 0 3px;">
                        <div id="strengthBar" style="height:100%;background:#4B3BC7;border-radius:2px;width:0%;transition:width 0.3s;"></div>
                    </div>
                    <div id="strengthLabel" style="font-size:10px;color:#888;"></div>
                    <span asp-validation-for="Password" style="font-size:10px;color:#e74c3c;display:block;"></span>
                </div>
                <div>
                    <div style="font-size:11px;color:#555;margin-bottom:4px;">Student number</div>
                    <input asp-for="StudentNumber" type="text" placeholder="Optional"
                           style="width:100%;border:0.5px solid #ddd;border-radius:7px;padding:8px 10px;font-size:12px;color:#26215C;background:#fff;outline:none;" />
                </div>
            </div>

            <button type="submit" style="width:100%;background:#4B3BC7;color:#fff;border:none;border-radius:8px;padding:11px;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;margin-top:4px;">
                <i class="ti ti-user-plus" aria-hidden="true"></i> Create my account
            </button>

            <div style="font-size:11px;color:#888;text-align:center;margin-top:10px;line-height:1.6;">
                By registering you agree to our <a href="#" style="color:#4B3BC7;">Terms of Use</a> and <a href="#" style="color:#4B3BC7;">Privacy Policy</a>.
            </div>
            <div style="font-size:12px;color:#888;text-align:center;margin-top:14px;">
                Already have an account? <a href="/auth/login" style="color:#4B3BC7;font-weight:500;">Log in here</a>
            </div>

            <div style="display:flex;align-items:center;gap:10px;margin:14px 0;">
                <div style="flex:1;height:0.5px;background:#e0ddf5;"></div>
                <span style="font-size:11px;color:#aaa;white-space:nowrap;">or sign up with</span>
                <div style="flex:1;height:0.5px;background:#e0ddf5;"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <button type="button" style="border:0.5px solid #ddd;border-radius:7px;padding:8px;font-size:12px;color:#444;background:#fff;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;">
                    <i class="ti ti-brand-google" aria-hidden="true" style="color:#EA4335;"></i> Google
                </button>
                <button type="button" style="border:0.5px solid #ddd;border-radius:7px;padding:8px;font-size:12px;color:#444;background:#fff;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;">
                    <i class="ti ti-brand-facebook" aria-hidden="true" style="color:#1877F2;"></i> Facebook
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Password strength indicator
        const input = document.getElementById('passwordInput');
        const bar   = document.getElementById('strengthBar');
        const label = document.getElementById('strengthLabel');
        if (input) {
            input.addEventListener('input', function () {
                const val = this.value;
                let strength = 0;
                if (val.length >= 8)            strength++;
                if (/[A-Z]/.test(val))          strength++;
                if (/[0-9]/.test(val))          strength++;
                if (/[^A-Za-z0-9]/.test(val))  strength++;
                const pct    = ['0%','25%','50%','75%','100%'][strength];
                const colors = ['#888','#B91C1C','#B45309','#4B3BC7','#27500A'];
                const labels = ['','Weak','Fair','Strong','Very strong'];
                bar.style.width     = pct;
                bar.style.background = colors[strength];
                label.textContent   = labels[strength];
                label.style.color   = colors[strength];
            });
        }
    </script>
}