@{
    ViewData["Title"] = "Manage Listings";
    Layout = "_Layout";
    var listings     = ViewBag.Listings     as List<VarsityTrade.Web.Models.Admin.AdminListingViewModel> ?? new();
    var activeFilter = ViewBag.ActiveFilter as string ?? "All";
    var totalCount   = (int)(ViewBag.TotalCount ?? 0);
    var activeCount  = (int)(ViewBag.ActiveCount ?? 0);
    var soldCount    = (int)(ViewBag.SoldCount ?? 0);
    var deletedCount = (int)(ViewBag.DeletedCount ?? 0);
}

<div style="display:flex;gap:12px;padding:16px 24px;align-items:start;">
    @await Html.PartialAsync("_SidebarAdmin")

    <div style="flex:1;min-width:0;">

        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div>
                <div style="font-size:15px;font-weight:500;color:#26215C;margin-bottom:2px;">
                    <i class="ti ti-list" aria-hidden="true" style="color:#4B3BC7;"></i> Manage listings
                </div>
                <div style="font-size:11px;color:#888;">All listings across all universities</div>
            </div>
        </div>

        @* Stats *@
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#EEEDFE;color:#26215C;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-list" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@totalCount</div><div style="font-size:10px;color:#888;">Total</div></div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#EAF3DE;color:#27500A;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-check" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@activeCount</div><div style="font-size:10px;color:#888;">Active</div></div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#f5f4f9;color:#888;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-tag" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@soldCount</div><div style="font-size:10px;color:#888;">Sold</div></div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#FDECEA;color:#B91C1C;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-trash" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@deletedCount</div><div style="font-size:10px;color:#888;">Removed</div></div>
            </div>
        </div>

        @* Filter tabs *@
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            @foreach (var f in new[] { "All", "Active", "Sold", "Flagged" })
            {
                <a href="/admin/listings?filter=@f"
                   style="font-size:11px;border:0.5px solid @(activeFilter==f?"#AFA9EC":"#ddd");border-radius:6px;padding:5px 10px;text-decoration:none;@(activeFilter==f?"background:#EEEDFE;color:#4B3BC7;font-weight:500;":"color:#666;background:#fff;")">
                    @f
                </a>
            }
        </div>

        @* Listings table *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="background:#f5f4f9;border-bottom:0.5px solid #e0ddf5;">
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Listing</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Seller</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">University</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Price</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Status</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in listings)
                    {
                        var statusStyle = listing.Status switch {
                            "Active"   => "background:#EAF3DE;color:#27500A;",
                            "Sold"     => "background:#f5f4f9;color:#888;",
                            "Reserved" => "background:#FEF3E2;color:#B45309;",
                            _          => listing.DeletedAt != null ? "background:#FDECEA;color:#B91C1C;" : "background:#f5f4f9;color:#888;"
                        };
                        var statusText = listing.DeletedAt != null ? "Removed" : listing.Status;
                        <tr style="border-bottom:0.5px solid #f0eefb;">
                            <td style="padding:10px 14px;">
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:32px;height:32px;background:#f0eefb;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#7F77DD;font-size:14px;flex-shrink:0;">
                                        <i class="ti ti-photo" aria-hidden="true"></i>
                                    </div>
                                    <div>
                                        <div style="font-size:12px;font-weight:500;color:#26215C;max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@listing.Title</div>
                                        <div style="font-size:10px;color:#888;">@listing.CategoryName · @listing.Condition</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding:10px 14px;font-size:11px;color:#444;">@listing.StoreName</td>
                            <td style="padding:10px 14px;font-size:11px;color:#444;">@listing.UniversityShortName</td>
                            <td style="padding:10px 14px;font-size:12px;font-weight:500;color:#4B3BC7;">R @listing.Price.ToString("N0")</td>
                            <td style="padding:10px 14px;">
                                <span style="font-size:10px;border-radius:4px;padding:2px 6px;@statusStyle">@statusText</span>
                            </td>
                            <td style="padding:10px 14px;">
                                <div style="display:flex;gap:4px;">
                                    <a href="/listings/@listing.ListingId" style="background:#EEEDFE;color:#4B3BC7;border:none;border-radius:5px;padding:4px 8px;font-size:10px;text-decoration:none;">View</a>
                                    @if (listing.DeletedAt == null)
                                    {
                                        <form asp-controller="Admin" asp-action="RemoveListing" method="post" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="@listing.ListingId" />
                                            <button type="submit" style="background:#FDECEA;color:#B91C1C;border:none;border-radius:5px;padding:4px 8px;font-size:10px;cursor:pointer;"
                                                    onclick="return confirm('Remove this listing?')">Remove</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!listings.Any())
            {
                <div style="text-align:center;padding:40px;font-size:12px;color:#888;">No listings found.</div>
            }
        </div>
    </div>
</div>