@{
    ViewData["Title"] = "Reports Queue";
    Layout = "_Layout";
    var reports      = ViewBag.Reports      as List<VarsityTrade.Web.Models.Admin.AdminReportViewModel> ?? new();
    var activeFilter = ViewBag.ActiveFilter as string ?? "All";
    var openCount    = (int)(ViewBag.OpenCount ?? 0);
    var totalCount   = (int)(ViewBag.TotalCount ?? 0);
}

<div style="display:flex;gap:12px;padding:16px 24px;align-items:start;">
    @await Html.PartialAsync("_SidebarAdmin")

    <div style="flex:1;min-width:0;">

        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div>
                <div style="font-size:15px;font-weight:500;color:#26215C;margin-bottom:2px;">
                    <i class="ti ti-flag" aria-hidden="true" style="color:#4B3BC7;"></i> Reports queue
                </div>
                <div style="font-size:11px;color:#888;">Review and resolve user-submitted reports</div>
            </div>
            @if (openCount > 0)
            {
                <span style="background:#FDECEA;color:#B91C1C;font-size:11px;border-radius:6px;padding:5px 12px;font-weight:500;">
                    @openCount open report@(openCount != 1 ? "s" : "") need attention
                </span>
            }
        </div>

        @* Filter tabs *@
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            @foreach (var f in new[] { "All", "Urgent", "Review", "Resolved" })
            {
                <a href="/admin/reports?filter=@f"
                   style="font-size:11px;border:0.5px solid @(activeFilter==f?"#AFA9EC":"#ddd");border-radius:6px;padding:5px 10px;text-decoration:none;@(activeFilter==f?"background:#EEEDFE;color:#4B3BC7;font-weight:500;":"color:#666;background:#fff;")">
                    @f
                </a>
            }
        </div>

        @if (reports.Any())
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var report in reports)
                {
                    var isUrgent  = report.ReportType == "Scam";
                    var borderStyle = isUrgent ? "border-left:3px solid #B91C1C;" : "border-left:3px solid #B45309;";
                    var iconStyle   = isUrgent ? "background:#FDECEA;color:#B91C1C;" : "background:#FEF3E2;color:#B45309;";
                    var badgeStyle  = isUrgent ? "background:#FDECEA;color:#B91C1C;" : "background:#FEF3E2;color:#B45309;";
                    var badgeText   = isUrgent ? "Urgent" : "Review";
                    <div style="background:#fff;border:0.5px solid #e0ddf5;@borderStyle border-radius:12px;overflow:hidden;">
                        <div style="padding:12px 16px;display:flex;align-items:center;gap:12px;border-bottom:0.5px solid #f0eefb;">
                            <div style="width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;@iconStyle">
                                <i class="ti ti-flag" aria-hidden="true"></i>
                            </div>
                            <div style="flex:1;">
                                <div style="font-size:13px;font-weight:500;color:#26215C;margin-bottom:2px;">@report.ReportType report</div>
                                <div style="font-size:11px;color:#888;">
                                    Reported by @report.ReportedByFirstName @report.ReportedByLastName ·
                                    @((int)(DateTime.UtcNow - report.CreatedAt).TotalHours)h ago
                                </div>
                            </div>
                            <span style="font-size:10px;border-radius:5px;padding:4px 10px;font-weight:500;@badgeStyle">@badgeText</span>
                        </div>

                        <div style="padding:10px 16px;border-bottom:0.5px solid #f0eefb;">
                            <div style="font-size:12px;color:#26215C;margin-bottom:4px;">
                                @if (!string.IsNullOrEmpty(report.ListingTitle))
                                {
                                    <span><i class="ti ti-tag" aria-hidden="true" style="color:#888;"></i> Listing: @report.ListingTitle</span>
                                }
                                else if (!string.IsNullOrEmpty(report.ReportedUserFirstName))
                                {
                                    <span><i class="ti ti-user" aria-hidden="true" style="color:#888;"></i> User: @report.ReportedUserFirstName @report.ReportedUserLastName</span>
                                }
                            </div>
                            <div style="font-size:11px;color:#666;">@report.Description</div>
                        </div>

                        <div style="padding:10px 16px;display:flex;align-items:center;justify-content:space-between;">
                            <div style="font-size:11px;color:#aaa;">@report.CreatedAt.ToString("dd MMM yyyy · HH:mm")</div>
                            @if (report.Status != "Resolved" && report.Status != "Dismissed")
                            {
                                <div style="display:flex;gap:6px;">
                                    <form asp-controller="Admin" asp-action="ResolveReport" method="post" style="margin:0;display:flex;gap:6px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reportId" value="@report.ReportId" />
                                        <button type="submit" name="status" value="Dismissed"
                                                style="background:#f5f4f9;color:#666;border:0.5px solid #ddd;border-radius:6px;padding:7px 12px;font-size:11px;cursor:pointer;">
                                            Dismiss
                                        </button>
                                        <button type="submit" name="status" value="Resolved"
                                                style="background:#4B3BC7;color:#fff;border:none;border-radius:6px;padding:7px 12px;font-size:11px;cursor:pointer;font-weight:500;">
                                            <i class="ti ti-check" aria-hidden="true"></i> Mark resolved
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span style="font-size:10px;background:#EAF3DE;color:#27500A;border-radius:5px;padding:4px 10px;">@report.Status</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;text-align:center;padding:60px 20px;">
                <i class="ti ti-flag" aria-hidden="true" style="font-size:40px;color:#AFA9EC;display:block;margin-bottom:12px;"></i>
                <div style="font-size:14px;font-weight:500;margin-bottom:6px;">No reports found</div>
                <p style="font-size:12px;color:#888;">All reports are resolved. The platform is running smoothly.</p>
            </div>
        }
    </div>
</div>