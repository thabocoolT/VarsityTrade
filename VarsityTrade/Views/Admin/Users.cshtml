@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
    var users = ViewBag.Users as List<VarsityTrade.Web.Models.Admin.AdminUserViewModel> ?? new();
    var activeFilter = ViewBag.ActiveFilter as string ?? "All";
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var bannedCount = (int)(ViewBag.BannedCount ?? 0);
}

<div style="display:flex;gap:12px;padding:16px 24px;align-items:start;">
    @await Html.PartialAsync("_SidebarAdmin")

    <div style="flex:1;min-width:0;">

        @* Page header *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div>
                <div style="font-size:15px;font-weight:500;color:#26215C;margin-bottom:2px;">
                    <i class="ti ti-users" aria-hidden="true" style="color:#4B3BC7;"></i> Manage users
                </div>
                <div style="font-size:11px;color:#888;">All registered students across all universities</div>
            </div>
        </div>

        @* Stats row *@
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#EEEDFE;color:#26215C;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-users" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@totalCount</div><div style="font-size:10px;color:#888;">Total</div></div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#EAF3DE;color:#27500A;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-user-check" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@activeCount</div><div style="font-size:10px;color:#888;">Active</div></div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#FDECEA;color:#B91C1C;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-user-off" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@bannedCount</div><div style="font-size:10px;color:#888;">Banned</div></div>
            </div>
            <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
                <div style="width:30px;height:30px;border-radius:8px;background:#FEF3E2;color:#B45309;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;"><i class="ti ti-user-plus" aria-hidden="true"></i></div>
                <div><div style="font-size:18px;font-weight:500;color:#26215C;">@users.Count(u => u.CreatedAt >= DateTime.UtcNow.AddDays(-7))</div><div style="font-size:10px;color:#888;">New this week</div></div>
            </div>
        </div>

        @* Toolbar *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <div style="flex:1;display:flex;align-items:center;border:0.5px solid #ddd;border-radius:6px;overflow:hidden;background:#f5f4f9;">
                <i class="ti ti-search" aria-hidden="true" style="padding:0 8px;color:#aaa;font-size:14px;"></i>
                <input type="text" placeholder="Search by name, email or university..." style="flex:1;border:none;outline:none;padding:6px 10px;font-size:12px;background:transparent;color:#26215C;" />
            </div>
            <select style="border:0.5px solid #ddd;border-radius:6px;padding:5px 8px;font-size:12px;color:#444;background:#fff;">
                <option>All universities</option>
            </select>
            <select style="border:0.5px solid #ddd;border-radius:6px;padding:5px 8px;font-size:12px;color:#444;background:#fff;">
                <option>All roles</option>
                <option>Buyer</option>
                <option>Admin</option>
            </select>
        </div>

        @* Filter tabs *@
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            @foreach (var f in new[] { "All", "Active", "Banned", "Deactivated", "New" })
            {
                <a href="/admin/users?filter=@f"
                   style="font-size:11px;border:0.5px solid @(activeFilter == f ? "#AFA9EC" : "#ddd");border-radius:6px;padding:5px 10px;text-decoration:none;@(activeFilter == f ? "background:#EEEDFE;color:#4B3BC7;font-weight:500;" : "color:#666;background:#fff;")">
                    @f
                </a>
            }
        </div>

        @* Users table *@
        <div style="background:#fff;border:0.5px solid #e0ddf5;border-radius:12px;overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="background:#f5f4f9;border-bottom:0.5px solid #e0ddf5;">
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">User</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">University</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Role</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Status</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Joined</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;color:#888;font-weight:500;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        var initials = $"{user.FirstName[0]}{user.LastName[0]}".ToUpper();
                        var statusStyle = user.IsBanned
                            ? "background:#FDECEA;color:#B91C1C;"
                            : user.IsActive
                                ? "background:#EAF3DE;color:#27500A;"
                                : "background:#f5f4f9;color:#888;";
                        var statusText = user.IsBanned ? "Banned" : user.IsActive ? "Active" : "Deactivated";
                        <tr style="border-bottom:0.5px solid #f0eefb;">
                            <td style="padding:10px 14px;">
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:28px;height:28px;border-radius:50%;background:#4B3BC7;color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;flex-shrink:0;">@initials</div>
                                    <div>
                                        <div style="font-size:12px;font-weight:500;color:#26215C;">@user.FirstName @user.LastName</div>
                                        <div style="font-size:10px;color:#888;">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding:10px 14px;font-size:11px;color:#444;">@user.UniversityShortName</td>
                            <td style="padding:10px 14px;">
                                <span style="font-size:10px;background:#EEEDFE;color:#3C3489;border-radius:4px;padding:2px 6px;">@user.Role</span>
                                @if (user.HasSellerProfile)
                                {
                                    <span style="font-size:10px;background:#EAF3DE;color:#27500A;border-radius:4px;padding:2px 6px;margin-left:3px;">Seller</span>
                                }
                            </td>
                            <td style="padding:10px 14px;">
                                <span style="font-size:10px;border-radius:4px;padding:2px 6px;@statusStyle">@statusText</span>
                            </td>
                            <td style="padding:10px 14px;font-size:11px;color:#888;">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td style="padding:10px 14px;">
                                <div style="display:flex;gap:4px;">
                                    @if (!user.IsBanned)
                                    {
                                        <form asp-controller="Admin" asp-action="BanUser" method="post" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <button type="submit" style="background:#FDECEA;color:#B91C1C;border:none;border-radius:5px;padding:4px 8px;font-size:10px;cursor:pointer;"
                                                    onclick="return confirm('Ban @user.FirstName @user.LastName?')">
                                                Ban
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="UnbanUser" method="post" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <button type="submit" style="background:#EAF3DE;color:#27500A;border:none;border-radius:5px;padding:4px 8px;font-size:10px;cursor:pointer;">
                                                Unban
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!users.Any())
            {
                <div style="text-align:center;padding:40px;font-size:12px;color:#888;">No users found.</div>
            }
        </div>
    </div>
</div>